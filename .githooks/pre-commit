#!/bin/sh
# Lint and format the fully staged files, then stage Biome's fixes. A file with unstaged changes is skipped,
# unchecked: Biome reads the file on disk, so fixing it would stage the hunks left out of this commit.
files=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR | grep -vxF "$(git -c core.quotePath=false diff --name-only)")
[ -n "$files" ] || exit 0
echo "$files" | tr '\n' '\0' | xargs -0 bunx --bun @biomejs/biome check --write --no-errors-on-unmatched --colors=off
echo "$files" | tr '\n' '\0' | xargs -0 git add --
