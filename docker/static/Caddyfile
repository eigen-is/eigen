# Static-only Eigen frontend. Serves the SPA bundles + proxies the API on plain HTTP :8080.
# A host web server (nginx, Caddy, Apache, Cloudflare Tunnel, Tailscale Funnel, ...) terminates
# HTTPS and forwards everything here. See docker/SETUP-GUIDE.md for wiring.

{
    auto_https off
    admin off
    servers {
        # The gateway only ever sees the host proxy over the docker bridge / loopback, so private
        # ranges are the trust boundary. Trust X-Real-IP only: it is single-valued and every host
        # snippet overwrites it, whereas a client can prepend to X-Forwarded-For and pick its key.
        trusted_proxies static private_ranges
        client_ip_headers X-Real-IP
    }
}

import site.Caddyfile

# No HSTS: the host web server in front of this plain :8080 terminates HTTPS.
:8080 {
    import site
}
