# ==========================================================================
# service type  private unpriv  chroot  wakeup  maxproc command + args
# ==========================================================================
# chroot is disabled (n) — the Docker container itself provides isolation.
# Chrooted Postfix processes can't read /etc/resolv.conf, breaking DNS.
smtp      inet  n       -       n       -       -       smtpd

# SMTP submission (port 587) — authenticated users send mail via external clients.
# The mismatch check must come BEFORE permit_sasl_authenticated, which would otherwise accept a
# forged sender first. The authenticated_ variant does nothing without a login, so the rule can
# never reject inbound mail if it ever leaks into main.cf.
# null_sender.regexp comes first because the identity map gives MAIL FROM:<> no owner, so the
# mismatch check would refuse the empty-sender bounces and auto-replies RFC 3834 asks for.
# The auth rate limit below is per client IP (per anvil_rate_time_unit, 60s by default); the hard
# error limit counts errors within one SMTP session.
# Why these values: SETUP-GUIDE.md § Mail abuse hardening.
submission inet n       -       n       -       -       smtpd
    -o syslog_name=postfix/submission
    -o smtpd_tls_security_level=encrypt
    -o smtpd_sasl_auth_enable=yes
    -o smtpd_sasl_type=dovecot
    -o smtpd_sasl_path=inet:dovecot:12345
    -o smtpd_sasl_security_options=noanonymous
    -o smtpd_sender_restrictions=check_sender_access,regexp:/etc/postfix/null_sender.regexp,reject_authenticated_sender_login_mismatch,permit_sasl_authenticated,reject
    -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
    -o smtpd_client_auth_rate_limit=20
    -o smtpd_hard_error_limit=5

# SMTPS (port 465) — implicit TLS, same auth and same limits as submission
smtps     inet  n       -       n       -       -       smtpd
    -o syslog_name=postfix/smtps
    -o smtpd_tls_wrappermode=yes
    -o smtpd_tls_security_level=encrypt
    -o smtpd_sasl_auth_enable=yes
    -o smtpd_sasl_type=dovecot
    -o smtpd_sasl_path=inet:dovecot:12345
    -o smtpd_sasl_security_options=noanonymous
    -o smtpd_sender_restrictions=check_sender_access,regexp:/etc/postfix/null_sender.regexp,reject_authenticated_sender_login_mismatch,permit_sasl_authenticated,reject
    -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
    -o smtpd_client_auth_rate_limit=20
    -o smtpd_hard_error_limit=5
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
        -o syslog_name=postfix/relay
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd

# Eigen delivery transport — pipes incoming mail to API via curl
eigen     unix  -       n       n       -       10      pipe
    flags=DRhu user=nobody argv=/usr/local/bin/eigen-deliver ${recipient}
