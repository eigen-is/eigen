# Test version of the Caddy snippet generated by scripts/setup.ts. Differs from the host
# snippet in two ways: plain HTTP instead of HTTPS (auto_https off), and proxies to
# `eigen-static:8080` over the docker network instead of `127.0.0.1:8080` on the host.
# The reverse_proxy directives that matter — flush_interval -1 for SSE, X-Forwarded-Proto,
# X-Real-IP — are identical.

{
    auto_https off
    admin off
}

:80 {
    encode gzip zstd
    reverse_proxy eigen-static:8080 {
        flush_interval -1
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }
}
