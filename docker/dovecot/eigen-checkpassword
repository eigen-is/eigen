#!/bin/bash
# Dovecot checkpassword auth against Eigen API.
# Protocol: reads username\0password\0 from fd 3.
# Success: set env + exec post-login. Refused credentials: exit 1. Temporary trouble: exit 111.
# Requires: bash (for read -d), curl, jq.

read -d $'\0' -r username <&3
read -d $'\0' -r password <&3

# Build JSON safely via jq to prevent shell injection.
# TCPREMOTEIP is the client address, exported under the DJB checkpassword names (dovecot's own `IP`
# is the LOCAL address, kept for old checkpassword-reply versions, so it must not be used here).
# For a submission login the client is the SMTP client, which Postfix reports to dovecot as `rip`.
# We pass it on so the API's per-IP failure limiter counts the real source and not the docker bridge
# peer. It is unset for internal sessions such as doveadm, and then the field is left out: the API
# takes `ip` as optional.
json_body=$(jq -nc --arg e "$username" --arg p "$password" --arg ip "${TCPREMOTEIP:-}" \
    '{email: $e, password: $p} + (if $ip == "" then {} else {ip: $ip} end)')

# No `-f`: it exits 22 for every HTTP >= 400, which turned a refused password into dovecot exit 111
# ("temporary failure"). Postfix then answers 454 4.7.0 and mail clients retry the same wrong
# password instead of asking the user for a new one, and dovecot re-runs or drops helper
# invocations, so some attempts never reach the failure limiter at all. Read the status instead:
# only a real connection failure or an unexpected status is temporary.
result=$(curl -s -w '\n%{http_code}' -X POST \
    -H "Content-Type: application/json" \
    -d "$json_body" \
    "http://eigen-api:8000/internal/auth/verify" 2>/dev/null)
curl_exit=$?

if [ $curl_exit -ne 0 ]; then
    exit 111  # API unreachable
fi

status="${result##*$'\n'}"
response="${result%$'\n'*}"

case "$status" in
    200) ;;
    401 | 403 | 429) exit 1 ;;  # credentials refused (429 = the failure limiter)
    *) exit 111 ;;              # 5xx, 404, empty: the API is unwell, not the password
esac

user_id=$(echo "$response" | jq -r '.userId // empty')
if [ -z "$user_id" ]; then
    exit 1  # Auth failed
fi

export USER="$username"
export HOME="/data/home/${user_id}/eigen.mail"
export userdb_uid=1000
export userdb_gid=1000
export userdb_home="/data/home/${user_id}/eigen.mail"
export userdb_mail="maildir:/data/home/${user_id}/eigen.mail/Maildir"

exec "$@"
