# The site both frontend modes serve: Caddyfile (HTTPS on the domain) and Caddyfile.static (plain :8080
# behind a host webserver) import it. {client_ip} is the peer in the first, the host proxy's X-Real-IP in the second.

(app) {
    redir /{args[0]} /{args[0]}/ 308
    handle_path /{args[0]}/* {
        root * /www/{args[0]}
        try_files {path} /index.html
        file_server
    }
}

(site) {
    encode gzip zstd

    # The CSP + referrer meta ride in each app's HTML.
    header X-Frame-Options SAMEORIGIN
    header X-Content-Type-Options nosniff
    header Referrer-Policy "strict-origin-when-cross-origin"
    header Permissions-Policy "camera=(), microphone=(), geolocation=()"

    @static path *.js *.css *.png *.jpg *.svg *.woff2 *.ttf *.woff *.eot
    header @static Cache-Control "public, max-age=31536000, immutable"

    # HTML shells revalidate so a deploy isn't masked by the browser's heuristic cache.
    @html not path /eigen/* /dav/* /.well-known/* *.js *.css *.png *.jpg *.svg *.woff2 *.ttf *.woff *.eot
    header @html Cache-Control "no-cache"

    # Localhost-only API routes (mail delivery + credential verify) must not be internet-reachable;
    # their real callers (Postfix/Dovecot) hit the API directly on the bridge, so 404 them here.
    @internal_only path /eigen/internal/* /eigen/mail/deliver/*
    handle @internal_only {
        respond 404
    }

    # API + WebSocket — strip /eigen/ prefix before proxying (Caddy forwards upgrade requests transparently)
    handle_path /eigen/* {
        reverse_proxy eigen-api:8000 {
            flush_interval -1
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # CalDAV + CardDAV — keep /dav/ prefix (API routes include it). Set X-Real-IP to the real client and
    # drop inbound X-Forwarded-For so a DAV client can't spoof its rate-limit bucket (matches /eigen/*).
    handle /dav/* {
        reverse_proxy eigen-api:8000 {
            header_up X-Real-IP {client_ip}
            header_up -X-Forwarded-For
        }
    }
    handle /.well-known/caldav {
        redir * /dav/ 301
    }
    handle /.well-known/carddav {
        redir * /dav/ 301
    }

    # Email autodiscovery — Apple Mail + Thunderbird autoconfig
    handle /.well-known/autoconfig/mail/config-v1.1.xml {
        root * /etc/caddy
        rewrite * /autoconfig.xml
        # templates only renders HTML and plain text unless told otherwise.
        templates {
            mime text/html text/plain application/xml text/xml
        }
        header Content-Type "application/xml"
        file_server
    }

    # CalDAV discovery — Apple Calendar sends PROPFIND/OPTIONS to the root URL
    @caldav_root {
        method PROPFIND OPTIONS
        path /
    }
    handle @caldav_root {
        rewrite * /dav/
        reverse_proxy eigen-api:8000 {
            header_up X-Real-IP {client_ip}
            header_up -X-Forwarded-For
        }
    }

    # Frontend apps (SPA routing via snippet)
    import app mail
    import app drive
    import app docs
    import app contacts
    import app calendar
    import app chat
    import app stickies
    import app slides
    import app sheets
    import app vector
    import app space
    import app admin

    # Landing page (fallback) — blog routes get per-route index.html with correct OG tags
    handle {
        root * /www/index
        try_files {path} {path}/index.html /index.html
        file_server
    }
}
