{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@workspace/lib": "workspace:*",
    "next-themes": "^0.4.6",
    "react-day-picker": "8.10.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": [
      "./src/components/*.tsx",
      "./src/components/*.ts"
    ],
    "./components/layout/*": [
      "./src/components/layout/*.tsx",
      "./src/components/layout/*.ts",
      "./src/components/layout/*/index.ts"
    ],
    "./components/layout/contacts": "./src/components/layout/contacts/index.ts",
    "./components/layout/contacts/*": [
      "./src/components/layout/contacts/*.tsx",
      "./src/components/layout/contacts/*.ts"
    ],
    "./components/layout/chat": "./src/components/layout/chat/index.ts",
    "./components/layout/chat/*": [
      "./src/components/layout/chat/*.tsx",
      "./src/components/layout/chat/*.ts"
    ],
    "./components/layout/drive": "./src/components/layout/drive/index.ts",
    "./components/layout/drive/*": [
      "./src/components/layout/drive/*.tsx",
      "./src/components/layout/drive/*.ts"
    ],
    "./components/layout/context-menu": "./src/components/layout/context-menu/index.ts",
    "./components/layout/context-menu/*": [
      "./src/components/layout/context-menu/*.tsx",
      "./src/components/layout/context-menu/*.ts"
    ],
    "./hooks/*": "./src/hooks/*.ts"
  }
}
