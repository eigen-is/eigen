#!/bin/sh
# Eigen's launcher, the ./eigen command an operator runs on the server to set up, update, back up, restore, start and
# stop an install. No container gets the Docker socket, so every Docker step runs here. The CLI in the API image asks
# the questions and writes the config, and the running API takes the commands that need it, such as a backup. It is
# POSIX sh, so it runs under dash and BusyBox.
set -eu

# Through a symlink such as /usr/local/bin/eigen too, this runs in the install folder.
cd "$(dirname "$(readlink -f "$0")")"

REPO=https://github.com/eigen-is/eigen
REGISTRY=ghcr.io/eigen-is/eigen
# The launcher cannot import the CLI, so the constants below that name one of the CLI's copy it. A test checks each pair.
# IMAGES is the CLI's IMAGE_NAMES. It is not read from compose config --images, which names only the images of the
# profiles in use, while a release pins them all.
IMAGES='api frontend postfix dovecot unbound'
# The CLI's exit code for a question answered no, its DECLINED.
DECLINED=3
# The exit code of restore --check-data for a database the build cannot open, its CANNOT_OPEN.
CANNOT_OPEN=4
# The CLI's SWAP_MARKER, and its RESTORING_DIR inside data/.
SWAP_MARKER=.eigen/restore-swap
UNSTAGE='cli_as 0 rm -rf data/.restoring'
LOG=.eigen/last-step.log
# POSIX sleep only takes whole seconds; the spinner falls back to 1 where 0.2 fails.
TICK=0.2
# The longest --in wait and message the restart notice takes: MAX_RESTART_WAIT_SECONDS and MAX_RESTART_MESSAGE_LENGTH.
MAX_WAIT=3600
MAX_MESSAGE=200

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    ACCENT=$(printf '\033[1;36m') GREEN=$(printf '\033[32m') RED=$(printf '\033[31m')
    YELLOW=$(printf '\033[33m') GRAY=$(printf '\033[90m') RESET=$(printf '\033[0m')
else
    ACCENT='' GREEN='' RED='' YELLOW='' GRAY='' RESET=''
fi
usage() {
    cat <<EOF
Usage: ./eigen <command>

Commands:
  setup            Configure Eigen, start it and print the link that finishes the setup
  status           Report on Eigen, its services, disk space, backups and certificate
  update           Update Eigen to the newest version
  rollback         Go back to the version before the last update
  restart          Start Eigen, and any part of it that stopped
  stop             Stop Eigen; ./eigen restart starts it again
  reset-password   Set a new password for an account
  backup           Back up the whole server into backups/ while Eigen runs
  restore          Put a whole-server backup back
  logs             Follow the logs
  help             Show this help

./eigen <command> --help tells more about one.

Environment:
  NO_COLOR=1       Plain output without color.
EOF
}

# The usage of the commands the launcher runs alone; the CLI prints its own for the others.
command_usage() {
    case $1 in
        status)
            cat <<EOF
Usage: ./eigen status

Reports on the version, a pending update, the services, disk space, the newest backup,
what restores kept aside, the certificate and the mail queue.
EOF
            ;;
        backup)
            cat <<EOF
Usage: ./eigen backup [--full | --s3] [--wait]

Backs up the whole server into backups/ while Eigen runs, and checks the archive. It
stops nothing. With Eigen stopped, a copy of data/ and .env.production is a backup too.
Exits 0 once the archive verified, 1 when it failed, 2 on a wrong argument, and 4
when it verified but did not reach the backup bucket.

  --full    Everything but the files in S3 buckets, which keep their own history (the default)
  --s3      The files in S3 buckets too
  --wait    Wait for a backup that runs to end, instead of failing
EOF
            ;;
        restore)
            cat <<EOF
Usage: ./eigen restore <archive> [--in <time> [message]] [--yes] [--s3-from-archive]

Puts a whole-server backup back: a name in backups/, or the path of an archive. It is
unpacked and checked while Eigen runs; then Eigen stops, data/ and .env.production are
swapped for the archive's, and Eigen starts on the version it was made with. What it
replaces is kept aside. On a new machine with Docker, it sets Eigen up from the archive.

  --in <time>         Warn everyone first, then wait before the stop: 10m, 90s, up to 1h. A
                      message after the time goes with the warning. Ctrl+C cancels.
  --yes               Do not ask
  --s3-from-archive   Upload the files an archive with S3 files holds under fresh keys,
                      instead of keeping each bucket as it is
EOF
            ;;
        logs)
            cat <<EOF
Usage: ./eigen logs [service]

Follows the logs of every service, or of one.
EOF
            ;;
        update)
            cat <<EOF
Usage: ./eigen update [version] [--in <time> [message]] [--check] [--accept-breaking]
                     [--no-backup]

Updates Eigen to the newest release, or to <version>. First, while Eigen runs, it makes
a full backup, which ./eigen rollback puts back when the version before cannot open the
data as it is. ./eigen update main follows the main channel instead of releases. Every
open tab is told before Eigen restarts.

  --in <time>         Warn everyone first, then wait: 10m, 90s, up to 1h. A message after the
                      time goes with the warning, as with shutdown: --in 10m "Back at three".
                      Ctrl+C cancels, and so does a lost SSH session: run a long wait in tmux.
  --check             Only tell whether there is an update, and what it brings
  --accept-breaking   Update even when the new version lists breaking changes
  --no-backup         Make none, as with Eigen stopped: copy data/ and .env.production first
EOF
            ;;
        rollback)
            kept=$(pre_update_archives | sed 's/^/  /')
            cat <<EOF
Usage: ./eigen rollback [--in <time> [message]] [--yes]

Goes back to the version before the last ./eigen update. First that version checks it opens
every database here: when it does, it starts on the data as it is, and the backup the update
made stays in backups/ for ./eigen restore. When it does not, the rollback puts that backup
back, and the current data is kept aside.

To go back further, ./eigen restore <file> puts back a backup an earlier update made. Kept:
${kept:-  none}

  --in <time>   Warn everyone first, then wait before the stop: 10m, 90s, up to 1h. A message
                after the time goes with the warning. Ctrl+C cancels.
  --yes         Do not ask
EOF
            ;;
        restart)
            cat <<EOF
Usage: ./eigen restart

Starts Eigen, and any part of it that stopped.
EOF
            ;;
        stop)
            cat <<EOF
Usage: ./eigen stop

Stops Eigen. When a server backup or its upload to the backup bucket is running, it
waits for that to end first. ./eigen restart starts it again.
EOF
            ;;
    esac
}

# refuse_usage <command> <why>: a wrong argument, said why, with the command's usage.
refuse_usage() {
    printf '%s\n\n' "$2" >&2
    command_usage "$1" >&2
    exit 2
}

# refuse <command> <argument>: an argument the command does not take.
refuse() { refuse_usage "$1" "Unknown argument \"$2\"."; }

# help_flag <command> <argument…>: --help among them prints its usage.
help_flag() {
    command=$1
    shift
    for arg in "$@"; do
        case $arg in -h | --help)
            command_usage "$command"
            exit 0
            ;;
        esac
    done
}

# arguments <command> <how many it takes> <argument…>: --help prints its usage; one argument too many is refused.
arguments() {
    command=$1 takes=$2
    shift 2
    help_flag "$command" "$@"
    if [ $# -gt "$takes" ]; then
        shift "$takes"
        refuse "$command" "$1"
    fi
}

# The glyphs are the CLI's GLYPHS, so its lines and these read alike. A write to a terminal that hung up fails, and
# the command must not end on it.
say() { printf '%s%s%s  %s\n' "$1" "$2" "$RESET" "$3" || :; }

# die <what went wrong> <what to do next>
die() {
    say "$RED" '■' "$1" >&2
    say "$GRAY" '└' "$2" >&2
    exit 1
}

wordmark() { printf '\n%seigen|%s⟩%s\n\n' "$ACCENT" "$1" "$RESET"; }

# The last KEY= line of .env.production, without its quotes: the launcher reads no value that needs unescaping.
env_value() {
    value=$(sed -n "s/^$1=//p" .env.production 2>/dev/null | tail -n 1)
    case $value in
        \'*) value=${value#?}; value=${value%%\'*} ;;
        \"*) value=${value#?}; value=${value%%\"*} ;;
        *) value=${value%% #*} ;;
    esac
    printf '%s\n' "$value"
}

# answer <key> <the CLI's key=value lines>: the value it gave for that key. The CLI it asks runs on /dev/null: on a
# terminal, Docker's pty would end each line in \r\n.
answer() { printf '%s\n' "$2" | sed -n "s/^$1=//p" | tail -n 1; }

# A folder with the build overlay, such as a clone of the repository, is a local build: setup builds its images.
if [ -f docker-compose.build.yml ]; then MODE=local; else MODE=release; fi

registry=$(env_value EIGEN_REGISTRY)
REGISTRY=${registry:-$REGISTRY}

image_key() { printf 'EIGEN_%s_IMAGE\n' "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"; }

# image <name>: the image Compose runs for it, as the environment or .env.production names it, else a local build's.
image() {
    key=$(image_key "$1")
    eval "ref=\${$key:-}"
    ref=${ref:-$(env_value "$key")}
    printf '%s\n' "${ref:-$REGISTRY/$1:local}"
}

API_IMAGE=$(image api)

# build_env: what the build overlay interpolates, which Compose does for every command, so a local build always
# exports it.
build_env() {
    BUN_VERSION=$(cat .bun-version)
    EIGEN_VERSION=$(sed -n 's/^  "version": "\(.*\)",$/\1/p' package.json | head -n 1)
    EIGEN_COMMIT=$(git -c safe.directory="$PWD" rev-parse --short HEAD 2>/dev/null || true)
    EIGEN_BUILT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    export BUN_VERSION EIGEN_VERSION EIGEN_COMMIT EIGEN_BUILT_AT
}
if [ "$MODE" = local ]; then build_env; fi

dc() {
    if [ -f docker-compose.override.yml ]; then set -- -f docker-compose.override.yml "$@"; fi
    if [ "$MODE" = local ]; then set -- -f docker-compose.build.yml "$@"; fi
    docker compose --env-file .env.production -f docker-compose.yml "$@"
}

# PROJECT: the Compose project, named the way Compose names it. Asked once, before the steps that use it, which run in
# subshells and would each ask again.
PROJECT=''
project() {
    if [ -z "$PROJECT" ]; then PROJECT=$(dc config 2>/dev/null | sed -n 's/^name: //p'); fi
}

# Whom a root run of the CLI gives what it writes: through Docker Desktop's file share, root in a container sees root.
EIGEN_OWNER=$(ls -ldn . | awk '{ print $3 ":" $4 }')
export EIGEN_OWNER

# cli_as <uid:gid> <command…>: the CLI in the API image on this folder, with the variables CLI_ENV names. A terminal on
# stdin gets one in the container, or a typed password would echo; asked per call, as step runs its command on /dev/null.
# ARCHIVE_MOUNT is the archive a restore reads from outside this folder, read-only.
CLI_ENV='' ARCHIVE_MOUNT=''
cli_as() {
    user=$1
    shift
    env='' tty=''
    for name in $CLI_ENV; do env="$env -e $name"; done
    if [ -t 0 ]; then tty=-t; fi
    docker run --rm --init -i $tty -e TERM -e NO_COLOR -e EIGEN_OWNER $env --user "$user" -e HOME=/tmp \
        ${ARCHIVE_MOUNT:+-v} ${ARCHIVE_MOUNT:+"$ARCHIVE_MOUNT"} -v "$PWD:/install" -w /install "$API_IMAGE" "$@"
}

# The CLI as the operator, so what it writes is theirs.
cli() { cli_as "$(id -u):$(id -g)" "$@"; }

api_running() { dc ps --status running --services 2>/dev/null | grep -qx eigen-api; }

# The CLI in the running API container, the only way to its control socket.
api_cli() {
    tty=''
    if [ ! -t 0 ]; then tty=-T; fi
    dc exec $tty -e TERM -e NO_COLOR eigen-api /app/docker/api/entrypoint.sh "$@"
}

# columns: the width of the terminal, 80 when it cannot be read.
columns() {
    width=$(stty size </dev/tty 2>/dev/null || :)
    width=${width#* }
    case $width in '' | 0 | *[!0-9]*) width=80 ;; esac
    printf '%s\n' "$width"
}

# duration <seconds>: as the spinner and the countdown show it, such as 45s or 2m 5s.
duration() {
    if [ "$1" -ge 60 ]; then echo "$(($1 / 60))m $(($1 % 60))s"; else echo "${1}s"; fi
}

# step <while running> <when done> <on failure> <command…>: one line per step, its output in $LOG, under a spinner on a
# terminal. set -m gives the job its own process group, so Ctrl-C stops all of it. A failure ends the launcher, or with
# STEP_GOES_ON set returns 1 after its output, leaving the next line to the caller.
step() {
    step_running=$1 step_done=$2 step_failed=$3
    shift 3
    code=0
    # A step may print a secret, so its log is the operator's alone.
    (umask 077 && : >"$LOG")
    if [ -t 1 ]; then
        set -m
        (set +e; "$@") >"$LOG" 2>&1 </dev/null &
        job=$!
        set +m
        trap 'kill -s TERM -- "-$job" 2>/dev/null || :; wait "$job" 2>/dev/null || :; printf "\r\033[K\033[1A\r\033[K\033[?25h"
            say "$RED" "■" "$step_running: cancelled." >&2; exit 130' INT TERM
        started=$(date +%s)
        frame=0
        # After a hangup printf fails (EIO), and set -e would end the launcher while the job runs on.
        printf '\033[?25l\n' || :
        while kill -0 "$job" 2>/dev/null; do
            case $((frame % 4)) in 0) glyph=◒ ;; 1) glyph=◐ ;; 2) glyph=◓ ;; *) glyph=◑ ;; esac
            frame=$((frame + 1))
            elapsed=$(duration $(($(date +%s) - started)))
            width=$(columns)
            # A wrapped line would break the redraw. BuildKit's "#12 3.45 …" loses its step number and timestamp.
            line=$(tail -n 20 "$LOG" 2>/dev/null | awk -v width=$((width - 4)) '{
                sub(/.*\r/, ""); gsub(/\033\[[0-9;?]*[A-Za-z]/, ""); gsub(/[[:cntrl:]]/, " ")
                sub(/^#[0-9]+ ([0-9]+\.[0-9]+ )?/, "")
            } NF && !/^(DONE [0-9.]+s|CACHED)$/ { line = $0 } END { print substr(line, 1, width) }')
            printf '\r\033[K\033[1A\r\033[K%s%s%s  %s...  %s%s%s\n\033[K%s│  %s%s' "$ACCENT" "$glyph" "$RESET" \
                "$step_running" "$GRAY" "$elapsed" "$RESET" "$GRAY" "$line" "$RESET" || :
            sleep "$TICK" 2>/dev/null || TICK=1
        done
        wait "$job" 2>/dev/null || code=$?
        trap 'exit 130' INT TERM
        printf '\r\033[K\033[1A\r\033[K\033[?25h' || :
    else
        "$@" >"$LOG" 2>&1 </dev/null || code=$?
    fi
    if [ "$code" = 0 ]; then
        say "$GREEN" '◇' "$step_done"
        return 0
    fi
    {
        say "$RED" '■' "$step_failed"
        tail -n 20 "$LOG" | sed "s/^/${GRAY}│${RESET}  /"
        if [ -n "${STEP_GOES_ON:-}" ]; then return 1; fi
        say "$GRAY" '└' "Full output: $LOG. ${NEXT:-Fix what it says, then run ./eigen $COMMAND again.}"
    } >&2
    exit 1
}

# compose_at_least <have> <want>: Compose versions like 2.24.4, number by number. Eigen's own versions the CLI orders.
compose_at_least() {
    awk -v have="$1" -v want="$2" 'BEGIN {
        split(have, h, "."); split(want, w, ".")
        for (i = 1; i <= 3; i++) if (h[i] + 0 != w[i] + 0) exit !(h[i] + 0 > w[i] + 0)
    }'
}

# preflight [quiet]: quiet leaves out the Docker line, for a command whose output is a report.
preflight() {
    # Not -r: group 1000 reads the file too, and ./eigen writes it.
    if [ -e .env.production ] && [ ! -w .env.production ]; then
        die ".env.production is not writable by this user." "Run ./eigen as the user that owns it, or as root."
    fi
    server=$(docker info --format '{{.ServerVersion}} {{.Architecture}} {{.OperatingSystem}}' 2>/dev/null || true)
    if [ -z "${server%% *}" ]; then
        die "Docker is not running, or this user cannot use it." "Start Docker, or run ./eigen as root or a member of the docker group."
    fi
    compose=$(docker compose version --short 2>/dev/null || true)
    compose=${compose#v}
    if [ -z "$compose" ]; then
        die "Docker Compose is not installed." "Install the Docker Compose plugin, version 2.20 or newer."
    fi
    need=2.20
    if [ -f docker-compose.override.yml ] && grep -q '!override' docker-compose.override.yml; then need=2.24.4; fi
    # Docker Desktop's 2.24.4-desktop.1 is 2.24.4, no prerelease.
    if ! compose_at_least "${compose%%-*}" "$need"; then
        die "Docker Compose $compose is too old for this install; it needs $need or newer." "Update the Docker Compose plugin, then run ./eigen $COMMAND again."
    fi
    arch=${server#* }
    docker_os=${arch#* }
    arch=${arch%% *}
    mkdir -p .eigen
    if [ "${1:-}" != quiet ]; then say "$GREEN" '◇' "Docker ${server%% *} on $arch, Compose $compose"; fi
    # The staged tree was checked before the swap wrote its marker, so a swap that was cut off goes on first.
    if [ -e "$SWAP_MARKER" ]; then finish_swap; fi
}

# Configure always writes DOMAIN; an unreadable .env.production is for preflight to report. A mirror install's holds
# EIGEN_REGISTRY alone before setup.
unconfigured() { [ ! -e .env.production ] || { [ -r .env.production ] && [ -z "$(env_value DOMAIN)" ]; }; }

# A swap cut off between its two renames of .env.production leaves none, and preflight finishes it.
need_install() {
    if unconfigured && [ ! -e "$SWAP_MARKER" ]; then die "Eigen is not set up in $PWD." "Run ./eigen setup first."; fi
}

# need_image <what to do>: the CLI comes with the API image, which a local build builds in ./eigen setup.
need_image() {
    if [ "$MODE" = local ] && ! docker image inspect "$API_IMAGE" >/dev/null 2>&1; then
        die "Eigen is not built yet." "$1"
    fi
}

# One command that changes Eigen at a time, or a nightly backup could stop Eigen in the middle of an update. The lock
# goes when the command ends, after AT_EXIT; update --pulled finds its own, handed over by exec.
AT_EXIT=''
lock() {
    if ! mkdir .eigen/lock 2>/dev/null; then
        # Another user's process cannot be asked whether it runs, and their lock cannot be taken over.
        if [ ! -w .eigen/lock ]; then
            holder=$(ls -ld .eigen/lock | awk '{ print $3 }')
            die "Another ./eigen command, run by $holder, holds .eigen/lock." "Wait for it to end, then run ./eigen $COMMAND again. If none runs, remove .eigen/lock as $holder or as root."
        fi
        pid=$(cat .eigen/lock/pid 2>/dev/null || :)
        # No pid yet is a launcher between its mkdir and its echo; the lock of a process that is gone is taken over.
        if [ -z "$pid" ] || { [ "$pid" != $$ ] && kill -0 "$pid" 2>/dev/null; }; then
            die "Another ./eigen command is running." "Wait for it to end, then run ./eigen $COMMAND again. If none runs, remove .eigen/lock."
        fi
    fi
    trap 'code=$?; (eval "$AT_EXIT") || code=$?; rm -rf .eigen/lock; exit "$code"' EXIT
    echo $$ >.eigen/lock/pid
}

# cli_help <CLI command>: the usage of a command the CLI parses.
cli_help() {
    need_image "Run ./eigen setup first; ./eigen $COMMAND --help works after that."
    cli "$1" --help
    exit
}

# A build is an api image, named by its labels as <version> (<revision>) on every install. Three files hold what an
# install is: .env.production pins what runs and what it follows (configure writes it from PINS), .eigen/bundle names
# the api image the files came from (write_bundle), .eigen/last-update the backup the last update made and the pins it
# switched away from (update_apply), until a restore swaps data/ (after_swap) or a rollback keeps it (switch_back).

# image_label <image> <version or revision>: that label of a local image.
image_label() { docker image inspect --format "{{index .Config.Labels \"org.opencontainers.image.$2\"}}" "$1"; }

# release_labels <image>: its org.opencontainers.image annotations in the registry, such as version and revision, as
# key=value lines for answer; without a pull, and none without annotations.
release_labels() {
    docker manifest inspect -v "$1" 2>/dev/null |
        sed -n 's/.*"org\.opencontainers\.image\.\([a-z]*\)": *"\([^"]*\)".*/\1=\2/p'
}

# describe <api image>: the build it is, as every message names one. Its die ends only the $(…): assign it bare.
describe() {
    label=$(image_label "$1" version 2>/dev/null) ||
        die "$1 is not here." "Run ./eigen update again; it downloads what it runs."
    echo "$label ($(image_label "$1" revision))"
}

# pull_images <tag> [name…]: its images, every image by default.
pull_images() {
    pulling=$1
    shift
    for name in ${*:-$IMAGES}; do docker pull "$REGISTRY/$name:$pulling" || return 1; done
}

# pull_refs <image…>: those not here yet, such as the digests an archive pins.
pull_refs() {
    for ref in "$@"; do docker image inspect "$ref" >/dev/null 2>&1 || docker pull "$ref" || return 1; done
}

# pin_images <tag>: PINS, the release as configure writes it, a key=value line each, every image by its registry
# digest. A tag moves image by image while a build is published, so its images must name one commit.
PINS=''
pin_images() {
    builds='' first='' mixed=''
    for name in $IMAGES; do
        revision=$(image_label "$REGISTRY/$name:$1" revision)
        if [ -z "$builds" ]; then first=$revision; elif [ "$revision" != "$first" ]; then mixed=1; fi
        builds="${builds:+$builds, }$name $revision"
    done
    if [ -n "$mixed" ]; then
        die "The images of $1 are from different builds: $builds." "A build of $1 is being published; run ./eigen $COMMAND again in a few minutes."
    fi
    PINS="EIGEN_REGISTRY=$REGISTRY
EIGEN_VERSION=$1"
    for name in $IMAGES; do
        digest=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' \
            "$REGISTRY/$name:$1" | grep -F "$REGISTRY/$name@" | head -n 1)
        if [ -z "$digest" ]; then
            die "$REGISTRY/$name:$1 has no registry digest." "Remove the local image (docker image rm $REGISTRY/$name:$1) and run ./eigen $COMMAND again."
        fi
        PINS="$PINS
$(image_key "$name")=$digest"
    done
}

# with_pins <command…>: runs it with PINS in its environment and the CLI's, where configure writes them from; out of
# the launcher's own, since Compose prefers the environment to .env.production.
with_pins() (
    for pin in $PINS; do
        export "$pin"
        CLI_ENV="$CLI_ENV ${pin%%=*}"
    done
    "$@"
)

# with_image <api image> <command…>: runs it with that image's CLI, for the one step of a command that another build
# than the one it runs on must do.
with_image() (
    API_IMAGE=$1
    shift
    "$@"
)

# The images .env.production pins, a line each.
pinned_refs() { for name in $IMAGES; do image "$name"; done; }

# What .env.production pins, as PINS spells it: an update records it for a rollback that keeps the data. A key the file
# lacks is left out, so the rollback writes no local build's name for it.
current_pins() {
    echo "EIGEN_REGISTRY=$REGISTRY"
    for key in EIGEN_VERSION $(for name in $IMAGES; do image_key "$name"; done); do
        value=$(env_value "$key")
        if [ -n "$value" ]; then echo "$key=$value"; fi
    done
}

# The api image .env.production pins, downloaded when it is not here: a pull that moves main leaves the build it
# replaced without a local name.
api_here() {
    pull_refs "$(image api)" >"$LOG" 2>&1 ||
        die "The image Eigen runs, $(image api), is not here and cannot be downloaded." "Check the network, then run ./eigen $COMMAND again."
}

# The API, uid 1000, reads .env.production for the server backup: group 1000 may, others not. Each command that writes it
# starts Eigen after, so start does this. Docker Desktop shows the file as the container user's, readable at 0600 already.
# backups/ gets the group backups_group names, with setgid and mode 2750: the operator lists it, and other users of the
# host do not. Its archives and their records are uid 1000's alone (0600), so the launcher asks the API what
# runs. A folder uid 1000 does not own is left as it is, since 2750 could lock the API out of it.
share_env() {
    if [ "$docker_os" = 'Docker Desktop' ]; then return 0; fi
    share_file='chgrp 1000 /install/.env.production && chmod 0640 /install/.env.production'
    share_folder='if [ -n "$1" ] && [ "$(stat -c %u /install/backups 2>/dev/null)" = 1000 ]; then chgrp "$1" /install/backups && chmod 2750 /install/backups; fi'
    docker run --rm --user 0 --entrypoint sh -v "$PWD:/install" "$API_IMAGE" -c "$share_file && $share_folder" sh "$(backups_group)"
}

# backups_group: the group of the install folder, which is the operator's, or nothing when other users of the host share
# it. A gid below 1000 other than root's is a system's shared group, such as users. So is one that lists another member,
# or that another user has as primary group.
backups_group() {
    gid=${EIGEN_OWNER#*:}
    if [ "$gid" != 0 ] && [ "$gid" -lt 1000 ]; then return 0; fi
    owner=$(ls -ld . | awk '{ print $3 }')
    members=$({ getent group "$gid" || grep "^[^:]*:[^:]*:$gid:" /etc/group; } 2>/dev/null | cut -d: -f4)
    if printf '%s\n' "$members" | tr ',' '\n' | grep -qvx -e "$owner" -e ''; then return 0; fi
    primary=$({ getent passwd || cat /etc/passwd; } 2>/dev/null | awk -F: -v gid="$gid" '$4 == gid { print $1 }')
    if printf '%s\n' "$primary" | grep -qvx -e "$owner" -e ''; then return 0; fi
    printf '%s\n' "$gid"
}

# shared_backups: a yellow line when share_env leaves backups/ open. The start runs share_env under step, whose output
# only the log gets, so restart says it before. A command that runs restart twice says it once.
shared_backups() {
    if [ "$docker_os" = 'Docker Desktop' ] || [ -n "$(backups_group)" ] || [ -n "${SHARED_SAID:-}" ]; then return 0; fi
    SHARED_SAID=1
    say "$YELLOW" '▲' "Other users of this host share this folder's group, ${EIGEN_OWNER#*:}, so backups/ stays open to them. Give the folder a group only you are in, then run ./eigen restart."
}

# Also removes this project's containers whose service the current profiles leave out, so a rerun that switches web
# or mail mode converges. Runs under step with set -e off, so failures return explicitly.
start() {
    services=$(dc config --services) || return 1
    active=" $(printf '%s ' $services)"
    project
    # Not a read loop: after a trapped signal, BusyBox's read spins and never returns.
    stale=$(docker ps -a --filter "label=com.docker.compose.project=$PROJECT" \
        --format '{{.ID}} {{.Label "com.docker.compose.service"}}' |
        awk -v active="$active" '!index(active, " " $2 " ") { print $1 }')
    if [ -n "$stale" ]; then docker rm -f $stale || return 1; fi
    share_env || return 1
    dc up -d --wait
}

# eigen-api mounts the one file, so it keeps the inode it started with: a .env.production an editor or sed -i wrote anew
# since is not the one it reads. Only a start of the container mounts the new one, and an up recreates it only when a
# value changed. Returns 1 when it reads another file, or none, as on Docker Desktop, and 2 when it cannot be asked.
env_mounted() {
    mounted=$(dc exec -T eigen-api sh -c 'cksum <"$EIGEN_ENV_FILE" 2>/dev/null || echo unreadable') || return 2
    [ "$mounted" = "$(cksum <.env.production)" ]
}

# A backup on the running API would hold the old file, or fail.
need_env_mounted() {
    mounted_code=0
    env_mounted || mounted_code=$?
    case $mounted_code in
        1)
            die ".env.production was replaced since Eigen started, and Eigen still reads the old one." \
                "Run ./eigen restart, then ./eigen $COMMAND again."
            ;;
        2) die "Could not ask eigen-api which .env.production it reads." "Run ./eigen logs eigen-api to see why." ;;
    esac
}

# restart [what to do on failure]: once a command has stopped Eigen or changed it, running it again would repeat that,
# so a failed start points at ./eigen restart.
restart() {
    NEXT=${1:-Fix what it says, then run ./eigen restart.}
    project
    mail=$(mail_containers)
    if api_running && ! env_mounted; then
        before_stop
        step "Stopping eigen-api, which reads an older .env.production" "eigen-api stopped" "Could not stop eigen-api" \
            dc stop eigen-api
    fi
    shared_backups
    step "Starting Eigen" "Eigen is running" "Eigen did not start; ./eigen logs shows why" start
    if [ "$(mail_containers)" != "$mail" ]; then refresh_fail2ban; fi
}

# Every container of this project, also those of services the current files no longer name.
stop_containers() {
    dc stop || return 1
    project
    ids=$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT")
    if [ -n "$ids" ]; then docker stop $ids; fi
}

# From the stop on, a hangup must not end the command halfway: dash runs no EXIT trap on one.
stop() {
    before_stop
    trap '' HUP
    project
    step "Stopping Eigen" "Eigen stopped" "Could not stop Eigen" stop_containers
}

# running_backup: what the running API says runs of a server backup, such as "the server backup <archive>", on one
# line, or nothing. It fails when the API does not answer, and then prints nothing.
running_backup() {
    running=$(api_cli status --running </dev/null 2>/dev/null) || return 1
    printf '%s\n' "$running"
}

# ask_backup <tries>: running_backup, asked again 2 s later while the API does not answer, <tries> times in all. One
# docker compose exec can fail on a busy host while the API and its backup run on.
ask_backup() {
    tries=$1
    until running_backup; do
        tries=$((tries - 1))
        if [ "$tries" = 0 ]; then return 1; fi
        sleep 2
    done
}

# wait_backup <what runs>: until the API names something else, or nothing. It fails after three failed asks in a row.
wait_backup() {
    while now=$(ask_backup 3); do
        if [ "$now" != "$1" ]; then return 0; fi
        sleep 2
    done
    return 1
}

# before_stop: a stop, and a restart that stops eigen-api, first waits for a running server backup or its upload. The
# stop would kill it, and that night would have no backup, or none in the bucket. Each step names what it waits for, so
# when a backup ends and its upload starts, the last line names the upload. A restore and an update wait before they
# arm the restart, and stop looks again. An API that does not answer, or stops answering, gets the stop it needs. An
# interrupt here leaves Eigen running. The restart notice expires a few minutes after its time, and a nightly backup
# can take longer, so a wait gives the tabs the notice again.
before_stop() {
    if ! api_running; then return 0; fi
    answered=1
    running=$(ask_backup 2) || answered=0
    # A notice that warn_restart armed is given again after a wait.
    renotice=''
    if [ -n "$running" ]; then case $AT_EXIT in *unannounce*) renotice=1 ;; esac; fi
    STEP_GOES_ON=1
    while [ "$answered" = 1 ] && [ -n "$running" ]; do
        step "Waiting for $running to end" "Waited for $running to end" \
            "Eigen stopped answering whether $running ended" wait_backup "$running" &&
            running=$(ask_backup 3) || answered=0
    done
    STEP_GOES_ON=''
    if [ "$answered" = 0 ]; then
        say "$YELLOW" '▲' "Eigen did not say whether a server backup runs, so the stop goes on."
    fi
    if [ -n "$renotice" ]; then announce 0 "$RESTART_REASON"; fi
}

# The server runs as 1000:1000. Only an empty folder is handed over: an existing one keeps its owners.
prepare_data() {
    mkdir -p data backups || return 1
    for dir in data backups; do
        if [ -z "$(ls -A "$dir" 2>/dev/null || echo unreadable)" ]; then
            docker run --rm --user 0 --entrypoint chown -v "$PWD/$dir:/$dir" "$API_IMAGE" 1000:1000 "/$dir" || return 1
        fi
    done
    docker run --rm --user 1000:1000 --entrypoint sh -v "$PWD/data:/data" -v "$PWD/backups:/backups" "$API_IMAGE" \
        -c 'for dir in /data /backups; do touch "$dir/.eigen-write-test" && rm "$dir/.eigen-write-test" || exit 1; done' || {
        echo "Eigen runs as uid 1000 and cannot write here. Give it the folders: sudo chown 1000:1000 data backups"
        return 1
    }
}

# where_archive <archive>: how the CLI reaches it, as STAGE_ARG in the API's container and CLI_ARG on this folder. A
# bare name is one in backups/, which both see; any other file is mounted read-only as /restore/<name>.
where_archive() {
    case $1 in
        */*) ;;
        *)
            STAGE_ARG=$1 CLI_ARG=backups/$1
            if [ -e "backups/$1" ]; then need_readable "backups/$1"; fi
            return
            ;;
    esac
    if [ ! -f "$1" ]; then die "There is no archive $1." "Name one in backups/, or pass the path of one."; fi
    need_readable "$1"
    name=$(basename "$1")
    dir=$(cd "$(dirname "$1")" && pwd -P)
    if [ "$dir" = "$(pwd -P)/backups" ]; then
        STAGE_ARG=$name CLI_ARG=backups/$name
    else
        case $dir/$name in *:*)
            die "Docker cannot mount $dir/$name, whose path has a colon." "Move the archive into backups/, then run ./eigen restore $name."
            ;;
        esac
        ARCHIVE_MOUNT="$dir/$name:/restore/$name:ro" STAGE_ARG=/restore/$name CLI_ARG=/restore/$name
    fi
}

# need_readable <archive>: the stage reads it as uid 1000, and a copy root made is often 0600. Docker Desktop shows a
# bind-mounted file as the container user's.
need_readable() {
    if [ "$docker_os" = 'Docker Desktop' ]; then return 0; fi
    if ! ls -lnL "$1" | awk '{ bit = $3 == 1000 ? 2 : $4 == 1000 ? 5 : 8; exit substr($1, bit, 1) != "r" }'; then
        die "Eigen runs as uid 1000, which cannot read $1." "Give it the file: sudo chown 1000:1000 $1"
    fi
}

# put_back: the archive where_archive found, staged, swapped in and started on the images it pins.
put_back() {
    before=$(image api)
    kept=$(kept_aside)
    # Docker would create a missing data/ as root for its bind mount, which the stage, uid 1000, cannot write.
    if [ ! -d data ]; then
        step "Preparing data/ and backups/" "Data folders ready" "The data folders are not writable" prepare_data
    fi
    stage_archive
    # It also refuses a staged tree the swap cannot rename in, while Eigen still runs.
    pins=$(cli_as 0 restore --staged </dev/null)
    if [ "$MODE" = release ]; then
        pin=$(answer EIGEN_API_IMAGE "$pins")
        if [ -n "$pin" ] && [ "$pin" != "$before" ]; then pull_pinned "$pins"; fi
    fi
    # After the question and the pull, so the wait is the last thing before the stop.
    warn_restart rollback
    swap_archive
    after_swap "$before"
    AT_EXIT=''
    restart
}

# stage_archive: while Eigen runs, the API's user unpacks and checks the archive into data/.restoring, on the data/
# the API sees, and asks unless $yes. A no ends the command; a refusal stops nothing.
stage_archive() {
    # The stage reads .env.production as the API does.
    share_env
    # What AT_EXIT held stays: after a rollback's second check, Eigen is stopped, and a no or a failure starts it.
    held=$AT_EXIT
    AT_EXIT="${held:+($held); }$UNSTAGE"
    tty=''
    if [ ! -t 0 ]; then tty=-T; fi
    # The CLI says how an interrupt ended it, so the launcher waits for it.
    trap : INT TERM
    staged=0
    # Without Compose's lines on the container it makes; its errors still print.
    dc --progress quiet run --rm --no-deps $tty -e TERM -e NO_COLOR ${ARCHIVE_MOUNT:+-v} ${ARCHIVE_MOUNT:+"$ARCHIVE_MOUNT"} \
        eigen-api restore "$STAGE_ARG" --stage $yes $s3 || staged=$?
    trap 'exit 130' INT TERM
    case $staged in
        0) ;;
        "$DECLINED")
            AT_EXIT=$held
            exit 0
            ;;
        *) exit "$staged" ;;
    esac
}

# pull_pinned <restore --staged lines>: the images the staged archive pins, got while Eigen runs on. They are named
# by the build the api image is, since EIGEN_VERSION may be a channel, such as main: by its labels when it is here
# already (a rollback pulled it), else by the registry's annotations, so an offline host asks no one. Without either
# they are named by EIGEN_VERSION.
pull_pinned() {
    refs=''
    for name in $IMAGES; do
        ref=$(answer "$(image_key "$name")" "$1")
        if [ -z "$ref" ]; then
            die "The archive pins no $name image." "Restore an archive made by ./eigen backup on a release install."
        fi
        refs="$refs $ref"
    done
    api=$(answer EIGEN_API_IMAGE "$1")
    build=$(image_label "$api" version 2>/dev/null) || build=''
    if [ -n "$build" ]; then
        build="$build ($(image_label "$api" revision))"
    else
        labels=$(release_labels "$api")
        build=$(answer version "$labels")
        if [ -n "$build" ]; then build="$build ($(answer revision "$labels"))"; else build=$(answer EIGEN_VERSION "$1"); fi
    fi
    step "Getting Eigen $build" "Eigen $build is here" "Could not get Eigen $build; Eigen runs on as it was" \
        pull_refs $refs
}

# swap_archive: stops Eigen and swaps the staged tree in. A swap refused before its marker starts Eigen on the data it
# had and ends the command; one cut off after it leaves Eigen stopped, for the next ./eigen command to finish.
swap_archive() {
    before_stop
    AT_EXIT="(restart); $UNSTAGE"
    stop
    trap : INT TERM
    swapped=0
    cli_as 0 restore --swap || swapped=$?
    trap 'exit 130' INT TERM
    if [ "$swapped" = 0 ]; then
        AT_EXIT=restart
        return
    fi
    if [ -e "$SWAP_MARKER" ]; then
        AT_EXIT=''
        say "$RED" '■' "The swap is unfinished and Eigen is stopped: ./eigen restart finishes it." >&2
    fi
    exit "$swapped"
}

# after_swap <the api image before the swap>: a release install runs the Compose files of the images the archive
# pins; a local build runs its own, which may need keys an older archive lacks. The last update's backup is no way back
# from the data swapped in.
after_swap() {
    rm -f .eigen/last-update
    API_IMAGE=$(image api)
    if [ "$MODE" = local ]; then
        NEXT="The data is restored. Fix what it says, then run ./eigen setup."
        step "Adding what is new to .env.production" ".env.production has what Eigen needs" \
            "Could not update .env.production" cli configure --backfill
    elif [ "$API_IMAGE" != "$1" ]; then
        NEXT="The data is restored. Fix what it says, then run ./eigen restart."
        write_bundle "$API_IMAGE"
    fi
    NEXT=''
}

# What restores kept aside in the install folder, as the swap names it, a name a line.
kept_aside() { ls -d data.pre-restore-* .env.production.pre-restore-* 2>/dev/null || :; }

# The last line of a restore: what its swap kept aside, if anything, is the operator's to delete.
check_kept() {
    if [ "$(kept_aside)" = "$kept" ]; then
        say "$GRAY" '└' "Check that all is well."
    else
        say "$GRAY" '└' "Check that all is well, then delete what was kept aside."
    fi
}

# finish_swap: a swap that was cut off, finished by the build whose files run it, then what follows any swap, and the
# start, which ./eigen stop leaves out.
finish_swap() {
    lock
    trap '' HUP
    swapper=$(cat .eigen/bundle 2>/dev/null || :)
    swapper=${swapper:-$(image api)}
    NEXT="Do what it says, then run ./eigen $COMMAND again."
    step "Finishing the restore that was cut off" "The restore that was cut off is finished" \
        "The restore that was cut off cannot be finished" with_image "$swapper" cli_as 0 restore --swap
    NEXT=''
    # A swap cut off after a rename set its aside before this run, so its Kept aside line tells, read before the next
    # step overwrites $LOG. An empty kept makes check_kept count every aside as kept.
    kept=$(kept_aside)
    if grep -q 'Kept aside: ' "$LOG"; then kept=''; fi
    after_swap "$swapper"
    if [ "$COMMAND" != stop ]; then restart; fi
    check_kept
}

# The IDs of the mail containers, stopped ones too: fail2ban's jails follow their logs by container ID.
mail_containers() {
    docker ps -a --filter "label=com.docker.compose.project=$PROJECT" \
        --format '{{.ID}} {{.Label "com.docker.compose.service"}}' | grep -E ' (postfix|dovecot)$' || :
}

# After a start that recreated the mail containers. The filters come with Eigen, the jail is the operator's.
refresh_fail2ban() {
    jail=/etc/fail2ban/jail.d/eigen-mail-sasl.conf
    if [ ! -e "$jail" ]; then return 0; fi
    filters="$PWD/docker/fail2ban/filter.d"
    if [ -w "$jail" ] && command -v fail2ban-client >/dev/null && cp "$filters"/*.conf /etc/fail2ban/filter.d/ &&
        fail2ban-client reload >/dev/null 2>&1; then
        say "$GREEN" '◇' "Fail2ban filters refreshed and jails reloaded"
    else
        say "$YELLOW" '▲' "Fail2ban still watches the old mail containers. As root, run:"
        say "$GRAY" '│' "cp $filters/*.conf /etc/fail2ban/filter.d/ && fail2ban-client reload"
    fi
}

# prune_images [image…]: the images an update leaves behind. Keeps those, the rollback's, and the images PINS
# names, and removes the rest by ID: an old build of main keeps no tag, only its digest, which no prune takes, and
# which a CLI from 29 on hides without --all. Best effort.
prune_images() {
    keep=' '
    for ref in "$@" $PINS; do keep="$keep${ref#*=} "; done
    for name in $IMAGES; do
        remove=$(docker image ls --all "$REGISTRY/$name" --digests \
            --format '{{.ID}} {{.Repository}}@{{.Digest}} {{.Repository}}:{{.Tag}}' | awk -v keep="$keep" '
            { ids[$1]; if (index(keep, " " $2 " ") || index(keep, " " $3 " ")) kept[$1] }
            END { for (id in ids) if (!(id in kept)) print id }')
        for id in $remove; do
            # The daemon is shared with other installs, and a stopped container keeps its image.
            if [ -z "$(docker ps -aq --filter "ancestor=$id")" ]; then docker image rm -f "$id" || :; fi
        done
    done
    docker image prune -f --filter "label=org.opencontainers.image.source=$REPO" || :
}

# write_bundle <api image>: a release install's launcher and Compose files, as that api image writes them, to temporary
# files that are renamed, so this running launcher reads on in its own copy. Files written halfway must read as stale:
# .eigen/bundle names an image .env.production does not pin yet first, as an update writes them, and one it pins
# already, as after a restore's swap, only once they are written.
write_bundle() {
    build=$(describe "$1")
    if [ "$1" != "$(image api)" ]; then echo "$1" >.eigen/bundle; fi
    step "Writing the Eigen $build launcher and Compose files" "Eigen $build files written" \
        "Could not write the Eigen $build files" with_image "$1" cli bootstrap --force --out /install
    echo "$1" >.eigen/bundle
}

# The api image of the files an unfinished update or restore wrote, when .env.production pins another.
stale_bundle() {
    bundle=$(cat .eigen/bundle 2>/dev/null || :)
    if [ -n "$bundle" ] && [ "$bundle" != "$(image api)" ]; then echo "$bundle"; fi
}

setup() {
    case ${1:-} in -h | --help) cli_help configure ;; esac
    # The variable --relay-password-env names goes into the CLI's container; the CLI refuses a name that is none.
    relay=''
    previous=''
    for arg in "$@"; do
        case $previous in --relay-password-env) relay=$arg ;; esac
        case $arg in --relay-password-env=*) relay=${arg#*=} ;; esac
        previous=$arg
    done
    CLI_ENV="EIGEN_PROJECT EIGEN_DOCKER_NETWORKS $relay"

    # Beside the launcher alone: bootstrap the pinned build, else the newest release, and hand over to its launcher,
    # lock included.
    if [ "$MODE" = release ] && [ ! -e docker-compose.yml ]; then
        preflight quiet
        lock
        pinned=$(env_value EIGEN_API_IMAGE)
        API_IMAGE=${pinned:-$REGISTRY/api:latest}
        step "Downloading Eigen" "Eigen downloaded" "Could not download Eigen" docker pull "$API_IMAGE"
        step "Writing the Eigen files" "Eigen files written" "Could not write the Eigen files" \
            cli bootstrap --force --out /install
        exec ./eigen setup "$@"
    fi
    wordmark setup
    preflight
    lock
    if [ "$MODE" = local ]; then
        # Compose loads env_file: even to build.
        if [ ! -e .env.production ]; then (umask 077 && : >.env.production); fi
        step "Building Eigen" "Eigen built" "Could not build Eigen" dc build eigen-api
    else
        version=$(env_value EIGEN_VERSION)
        if [ -z "$version" ]; then
            die ".env.production names no Eigen release." "Get one into it: docker run --rm --pull always -v \"\$PWD:/out\" $REGISTRY/api:latest bootstrap --force"
        fi
        # A tag is resolved to digests once, by the first setup or by update: a rerun gets the images already pinned.
        case $(image api) in
            *@sha256:*) download="pull_refs $(pinned_refs)" ;;
            *) download="pull_images $version" ;;
        esac
        step "Downloading Eigen $version" "Eigen $version downloaded" "Could not download Eigen $version" $download
        case $download in pull_images*) pin_images "$version" ;; esac
    fi

    # configure picks a free subnet from this list; the CLI container cannot ask Docker itself.
    docker network inspect $(docker network ls -q) >.eigen/networks.json ||
        die "Could not list the Docker networks." "Check that Docker is running, then run ./eigen setup again."
    EIGEN_DOCKER_NETWORKS=/install/.eigen/networks.json
    project
    EIGEN_PROJECT=$PROJECT
    export EIGEN_DOCKER_NETWORKS EIGEN_PROJECT
    with_pins cli configure "$@" || exit
    # The build the files came from, which finishes a swap that was cut off before any update wrote them.
    if [ "$MODE" = release ] && [ ! -e .eigen/bundle ]; then image api >.eigen/bundle; fi

    if [ "$MODE" = local ]; then
        step "Building the web and mail images" "Images built" "Could not build the images" \
            dc build $(dc config --services | grep -vx eigen-api)
    fi
    step "Preparing data/ and backups/" "Data folders ready" "The data folders are not writable" prepare_data
    restart "Fix what it says, then run ./eigen setup again."
    api_cli setup-link
}

# Only the launcher can ask Docker; with Eigen down there is no socket, and the CLI runs on its own, on the names in
# backups/.
status() {
    arguments status 0 "$@"
    need_install
    wordmark status
    preflight quiet
    # Empty when the check fails; a local build has none.
    newer=''
    if [ "$MODE" = release ]; then
        if [ "$(env_value EIGEN_VERSION)" = main ]; then
            newer="--latest=$(answer revision "$(release_labels "$REGISTRY/api:main")")"
        else
            newer="--latest=$(answer version "$(release_labels "$REGISTRY/api:latest")")"
        fi
    fi
    tab=$(printf '\t')
    listed=$(dc ps -a --format "{{.Service}}$tab{{.State}}$tab{{.Health}}") ||
        die "Could not read the state of the services." "Fix what Docker Compose says above, then run ./eigen status again."
    services=''
    for service in $(dc config --services); do
        line=$(printf '%s\n' "$listed" | grep "^$service$tab" | head -n 1)
        services="$services${line:-$service${tab}missing$tab}
"
    done

    # Empty when postqueue fails; the CLI tells that from a stopped postfix by the service list.
    queue=''
    case $services in *"postfix${tab}running$tab"*)
        queue=$(dc exec -T postfix postqueue -p 2>/dev/null | tail -n 1)
        ;;
    esac

    runner=cli
    case $services in *"eigen-api${tab}running$tab"*) runner=api_cli ;; esac
    set -- --install="$PWD" --services="$services" --mail-queue="$queue" --backups="$(ls backups 2>/dev/null || :)" \
        ${newer:+"$newer"}
    bundle=$(stale_bundle)
    if [ -n "$bundle" ]; then
        files=$(describe "$bundle")
        set -- "$@" --files="$files"
    fi
    # Their size is left out: du would read all of a copy of data/, which is uid 1000's.
    kept=$(kept_aside)
    "$runner" status "$@" ${kept:+"--kept-aside=$kept"}
}

# The running API makes the backup: its job map keeps a backup off a home a restore writes and waits for it at shutdown.
# It stops nothing, so it takes no lock.
backup() {
    level=full wait=''
    help_flag backup "$@"
    for arg in "$@"; do
        case $arg in
            --full) ;;
            --s3) level=full-s3 ;;
            --wait) wait=--wait ;;
            *) refuse backup "$arg" ;;
        esac
    done
    need_install
    wordmark backup
    preflight
    if ! api_running; then
        die "Eigen is not running, and a backup runs on the running server." \
            "Start it with ./eigen restart. With Eigen stopped, a copy of data/ and .env.production is a backup too."
    fi
    need_env_mounted
    api_cli backup --level "$level" $wait
}

# in_argument <command> <argument>: takes --in, its time and the message that may follow it, as shutdown takes
# `+10 "message"`, into IN_SECONDS and IN_MESSAGE. Returns 1 for any other argument, which the command parses itself.
# A time is digits and s, m or h, or 0 alone, so a bare 10 never waits ten seconds for someone who meant minutes.
# Checked before anything runs. dash counts the message in bytes, so one with accents may hold fewer characters.
IN_TIME='' IN_SECONDS=0 IN_MESSAGE='' IN_NEXT=''
in_argument() {
    case $IN_NEXT in
        time)
            IN_TIME=$2 IN_NEXT=message
            number=${2%[smh]}
            case $2 in
                0) return 0 ;;
                *s) unit=1 ;;
                *m) unit=60 ;;
                *h) unit=3600 ;;
                *) number='' ;;
            esac
            case $number in '' | *[!0-9]*)
                refuse_usage "$1" "--in takes a time with its unit, such as 10m, 90s or 1h, or 0; not \"$2\"."
                ;;
            esac
            # Without its leading zeros, which $(( )) would read as octal.
            number=${number#"${number%%[!0]*}"}
            if [ ${#number} -gt 4 ] || [ $((${number:-0} * unit)) -gt "$MAX_WAIT" ]; then
                refuse_usage "$1" "--in waits an hour at most."
            fi
            IN_SECONDS=$((${number:-0} * unit))
            return 0
            ;;
        message)
            IN_NEXT=''
            case $2 in -*) return 1 ;; esac
            if [ ${#2} -gt "$MAX_MESSAGE" ]; then refuse_usage "$1" "The message is over $MAX_MESSAGE characters."; fi
            IN_MESSAGE=$2
            return 0
            ;;
    esac
    if [ "$2" != --in ]; then return 1; fi
    IN_NEXT=time
}

# need_in_time <command>: after the arguments, a --in without its time is refused.
need_in_time() {
    if [ "$IN_NEXT" = time ]; then refuse_usage "$1" "--in takes a time, such as 10m."; fi
}

# warn_restart <reason>: when Eigen runs, tells every open tab that it restarts, for an update or a rollback, then
# waits out --in. From here an exit, Ctrl+C or a hangup takes the notice back through AT_EXIT, so no tab warns of a
# restart that does not come. dash runs no EXIT trap on a hangup it does not trap. RESTART_REASON keeps the reason,
# for before_stop to give the notice again.
RESTART_REASON=''
warn_restart() {
    if ! api_running; then return 0; fi
    RESTART_REASON=$1
    AT_EXIT="${AT_EXIT:+$AT_EXIT; }unannounce"
    trap 'exit 129' HUP
    announce "$IN_SECONDS" "$1"
    if [ "$IN_SECONDS" -gt 0 ]; then countdown; fi
}

# announce <seconds> <reason>: the notice of a restart in <seconds>, with IN_MESSAGE, on the running API. It runs in
# this process, not as a step's job, so a hangup cannot leave a notice landing after unannounce took it back. One with
# a wait stops the command when it fails, since the wait would warn nobody. One for now is best-effort: an API that
# cannot take it holds nothing up.
announce() {
    told=$(api_cli restart-notice --in "$1" --reason "$2" ${IN_MESSAGE:+--message} ${IN_MESSAGE:+"$IN_MESSAGE"} \
        </dev/null 2>&1) || {
        if [ "$1" = 0 ]; then
            say "$YELLOW" '▲' "Could not tell the open tabs that Eigen restarts now."
            return 0
        fi
        {
            say "$RED" '■' "Could not tell the open tabs; Eigen runs on as it was"
            printf '%s\n' "$told" | tail -n 20 | sed "s/^/${GRAY}│${RESET}  /"
            say "$GRAY" '└' "Fix what it says, then run ./eigen $COMMAND again."
        } >&2
        exit 1
    }
    if [ "$1" = 0 ]; then return 0; fi
    say "$GREEN" '◇' "Told the open tabs"
    RESTART_AT=$(answer at "$told" | sed 's/^.*T//; s/\.[0-9]*Z$/ UTC/')
}

# unannounce: takes the notice back. The API it asks may be down.
unannounce() { api_cli restart-notice --clear </dev/null >/dev/null 2>&1 || :; }

# countdown: waits out IN_SECONDS in this process, a second at a time, so a hangup's trap runs at once. A terminal
# sees one line count down, as shutdown warns; a log gets it once.
countdown() {
    end=$(($(date +%s) + IN_SECONDS)) left=$IN_SECONDS
    if [ -n "$IN_MESSAGE" ]; then say "$GRAY" '│' "$IN_MESSAGE"; fi
    trap 'if [ -t 1 ]; then printf "\r\033[K" || :; fi
        say "$RED" "■" "The wait was cancelled. Eigen runs on as it was." >&2; exit 130' INT TERM
    while [ "$left" -gt 0 ]; do
        line="Restarts in $(duration "$left"), at $RESTART_AT. Ctrl+C cancels."
        if [ -t 1 ]; then
            # A line that wraps leaves a line a second: \r only goes back to the start of the last one.
            width=$(columns)
            if [ "$width" -gt 4 ]; then line=$(printf '%s\n' "$line" | cut -c "1-$((width - 4))"); fi
            printf '\r\033[K%s◆%s  %s' "$ACCENT" "$RESET" "$line" || :
        elif [ "$left" = "$IN_SECONDS" ]; then
            say "$ACCENT" '◆' "$line"
        fi
        sleep 1
        left=$((end - $(date +%s)))
    done
    trap 'exit 130' INT TERM
    if [ -t 1 ]; then printf '\r\033[K' || :; fi
    say "$GREEN" '◇' "Waited until $RESTART_AT"
}

restore() {
    archive='' yes='' s3=''
    help_flag restore "$@"
    for arg in "$@"; do
        if in_argument restore "$arg"; then continue; fi
        case $arg in
            --yes) yes=--yes ;;
            --s3-from-archive) s3=--s3-from-archive ;;
            -*) refuse restore "$arg" ;;
            *)
                if [ -n "$archive" ]; then refuse restore "$arg"; fi
                archive=$arg
                ;;
        esac
    done
    need_in_time restore
    # After --in, an archive reads as the message: a name that ends in .tar, or one of a file that exists.
    if [ -z "$archive" ] && { [ "${IN_MESSAGE%.tar}" != "$IN_MESSAGE" ] || [ -f "$IN_MESSAGE" ] ||
        [ -f "backups/$IN_MESSAGE" ]; }; then
        refuse_usage restore "Put the archive before --in: ./eigen restore $IN_MESSAGE --in $IN_TIME"
    fi
    if [ -z "$archive" ]; then
        die "Name the archive to restore." "Pass a name in backups/, or the path of an archive: ./eigen restore <archive>"
    fi
    wordmark restore
    preflight
    where_archive "$archive"
    if [ "$MODE" = release ] && unconfigured; then restore_fresh "$@"; fi
    need_install
    need_image "Run ./eigen setup first, then ./eigen restore <archive>."
    if [ "$MODE" = release ]; then api_here; fi
    lock
    put_back
    check_kept
}

# A new machine: the launcher alone, as the installer leaves it, or beside a mirror's .env.production. The archive's
# .env.production pins the build that restores it and holds what setup asks, so setup does not run; that build's
# launcher takes over, lock and all. A mirror's file waits in .eigen/ until the archive's is in place.
restore_fresh() {
    lock
    # dash runs no EXIT trap on a hangup, and the one below puts the mirror's .env.production back.
    trap '' HUP
    if [ -e .env.production ]; then mv .env.production .eigen/mirror.env; fi
    AT_EXIT='rm -f .env.production; if [ -e .eigen/mirror.env ]; then mv .eigen/mirror.env .env.production; fi'
    API_IMAGE=$REGISTRY/api:latest
    step "Downloading Eigen" "Eigen downloaded" "Could not download Eigen" docker pull "$API_IMAGE"
    step "Reading the archive" ".env.production taken from the archive" "The archive cannot be restored here" \
        cli_as 0 restore "$CLI_ARG" --env
    API_IMAGE=$(image api)
    version=$(env_value EIGEN_VERSION)
    step "Downloading Eigen $version" "Eigen $version downloaded" "Could not download Eigen $version" \
        pull_refs $(pinned_refs)
    write_bundle "$API_IMAGE"
    step "Preparing data/ and backups/" "Data folders ready" "The data folders are not writable" prepare_data
    AT_EXIT=''
    rm -f .eigen/mirror.env
    exec ./eigen restore "$@"
}

update() {
    target='' check=0 accept='' pulled=0 saved='' no_backup='' previous=''
    help_flag update "$@"
    for arg in "$@"; do
        case $previous in --saved)
            saved=$arg previous=''
            continue
            ;;
        esac
        if in_argument update "$arg"; then continue; fi
        case $arg in
            --check) check=1 ;;
            --accept-breaking) accept=--accept-breaking ;;
            --no-backup) no_backup=--no-backup ;;
            # The handover from the launcher that got the new version to the one that came with it, with the backup
            # it made.
            --pulled) pulled=1 ;;
            --saved) ;;
            -*) refuse update "$arg" ;;
            *) if [ -n "$target" ]; then refuse update "$arg"; fi; target=$arg ;;
        esac
        previous=$arg
    done
    need_in_time update
    if [ "$check" = 1 ] && [ -n "$IN_TIME" ]; then refuse_usage update "--check updates nothing, so it takes no --in."; fi
    # After --in, a version would read as the message. Only a single word can be one: a sentence that mentions a
    # version is a message.
    if [ -z "$target" ]; then
        case $IN_MESSAGE in
            *' '*) ;;
            *) if release_name "$IN_MESSAGE"; then
                refuse_usage update "Put the version before --in: ./eigen update $IN_MESSAGE --in $IN_TIME"
            fi ;;
        esac
    fi
    if [ "$MODE" = local ]; then
        die "A local build has no updates." "Pull the code and run ./eigen setup again, which builds it."
    fi
    # The old launcher's notice is on the tabs, and exec dropped its traps: from here a failure takes it back.
    if [ "$pulled" = 1 ]; then
        lock
        AT_EXIT=unannounce RESTART_REASON=update
        trap 'exit 129' HUP
    fi
    need_install
    if [ "$pulled" = 1 ]; then
        preflight quiet
    else
        wordmark update
        preflight
    fi
    if [ "$check" = 0 ] && [ "$pulled" != 1 ]; then lock; fi
    if [ "$pulled" = 1 ]; then update_apply; else update_get; fi
}

# release_name <name>: a release ./eigen update can go to: a version, latest, or main, the only channel. A version is
# the CLI's VERSION_PATTERN, loosely.
release_name() {
    case $1 in
        latest | main | [0-9]*.[0-9]*.[0-9]*) return 0 ;;
        *) return 1 ;;
    esac
}

# The part the launcher the operator typed runs, while Eigen runs on: get the new version, check it, and hand over to
# the launcher that came with it.
update_get() {
    # Any other tag, such as a candidate the publish workflow pushes, is no release.
    if [ -n "$target" ] && ! release_name "$target"; then
        die "Eigen has no \"$target\"." "Name a version (./eigen update 1.2.3), latest, or the main channel (./eigen update main)."
    fi
    follows=$(env_value EIGEN_VERSION)
    if [ -z "$follows" ]; then die ".env.production names no Eigen release." "Run ./eigen setup first."; fi
    api_here
    current=$(describe "$(image api)")
    # Release notes and the breaking question go by version.
    old_version=$(image_label "$(image api)" version)
    tag=${target:-latest}
    if [ -z "$target" ] && [ "$follows" = main ]; then tag=main; fi
    labels=$(release_labels "$REGISTRY/api:$tag")
    version=$(answer version "$labels") revision=$(answer revision "$labels")
    if [ -z "$version" ]; then
        # Without the annotations, the image's labels name the build.
        step "Looking for Eigen $tag" "Found Eigen $tag" "Could not get Eigen $tag. Releases: $REPO/releases" \
            docker pull "$REGISTRY/api:$tag"
        version=$(image_label "$REGISTRY/api:$tag" version) revision=$(image_label "$REGISTRY/api:$tag" revision)
        if [ -z "$version" ]; then
            die "$REGISTRY/api:$tag names no version." "Name one: ./eigen update <version>. Releases: $REPO/releases"
        fi
    fi
    # latest moves on: the release it names is what is pulled, pinned and recorded.
    if [ "$tag" = latest ]; then tag=$version; fi
    new="$version ($revision)"
    # Up to date: the same build, on the line the install already follows.
    if [ "$new" = "$current" ] && [ "$tag" = "$follows" ]; then
        if [ "$check" = 1 ]; then
            say "$GRAY" '└' "Eigen $current is up to date."
            exit 0
        fi
        # An update that stopped halfway, to whatever target, left the files of another build.
        if [ -n "$(stale_bundle)" ]; then write_bundle "$(image api)"; fi
        restart
        say "$GRAY" '└' "Eigen $current is up to date and running at https://$(env_value DOMAIN)/"
        exit 0
    fi
    # The new version's CLI tells what changed since the old one, and refuses a downgrade.
    API_IMAGE=$REGISTRY/api:$tag
    step "Getting the notes of Eigen $new" "Eigen $new is out" "Could not get Eigen $new" pull_images "$tag" api
    # The tag may have moved since the manifest was read.
    new=$(describe "$REGISTRY/api:$tag")
    if [ "$check" = 1 ]; then
        cli update-check --from "$old_version" --accept-breaking
        say "$GRAY" '└' "./eigen update installs it."
        exit 0
    fi
    checked=0
    cli update-check --from "$old_version" $accept || checked=$?
    case $checked in 0) ;; "$DECLINED") exit 0 ;; *) exit "$checked" ;; esac
    if [ -z "$no_backup" ]; then
        if ! api_running; then
            die "Eigen is not running, and the backup an update makes first runs on the running server." \
                "Start it with ./eigen restart, then run ./eigen update again. Or copy data/ and .env.production somewhere safe, then run ./eigen update --no-backup."
        fi
        need_env_mounted
    fi
    step "Downloading Eigen $new" "Eigen $new downloaded" "Could not download Eigen $new" pull_images "$tag"
    downloaded=$(describe "$REGISTRY/api:$tag")
    if [ "$downloaded" != "$new" ]; then
        die "$tag moved while downloading: the notes were of Eigen $new." "Run ./eigen update again."
    fi
    pin_images "$tag"
    # The pulls and the questions are done, so the wait comes right before the backup, which then misses little.
    warn_restart update
    if [ -z "$no_backup" ]; then
        # The operator may have edited the file during the wait.
        if [ "$IN_SECONDS" -gt 0 ]; then need_env_mounted; fi
        # Before the files of the new version, which a failure would leave with the old images, and before its
        # configure --backfill, so the archive holds the .env.production this build runs on.
        NEXT="Eigen $current runs on as it was. Fix what it says, then run ./eigen update again. Or copy data/ and .env.production somewhere safe, then run ./eigen update --no-backup."
        step "Backing up Eigen $current" "Backed up Eigen $current" "Could not back up Eigen $current" \
            api_cli backup --reason pre-update --wait
        NEXT=''
        saved=$(answer archive "$(cat "$LOG")")
        if [ -z "$saved" ]; then
            die "The backup named no archive." "Eigen $current runs on as it was. Run ./eigen update again; $LOG shows what the backup said."
        fi
        # A home backed up with warnings is in it without what they name, and the step's line alone hides that.
        sed -n 's/^▲  //p' "$LOG" | while IFS= read -r line; do say "$YELLOW" '▲' "$line"; done
        # What changes from here to the stop is not in it: the operator is told until when it holds.
        say "$GRAY" '│' "backups/$saved, made until $(date -u +%H:%M:%S) UTC"
        # The backup may have outlasted the notice's expiry, which starts over for the handover and the stop.
        announce 0 update
    fi
    write_bundle "$(answer EIGEN_API_IMAGE "$PINS")"
    # The notice holds on until the new launcher stops Eigen.
    AT_EXIT=''
    # The new launcher gets the tag and what it saves as arguments and parses them as this one did; no variable crosses.
    exec ./eigen update --pulled "$tag" ${saved:+--saved "$saved"}
}

# The part the launcher of the new version runs: stop, switch and start.
update_apply() {
    # Up to the stop, which ends the old API and its notice, a failure or a hangup takes back the notice the old
    # launcher gave (armed in update).
    domain=$(env_value DOMAIN)
    if [ ! -d data ]; then die "There is no data/ in $PWD." "Run ./eigen update in the install folder."; fi
    pin_images "$target"
    api_here
    old_image=$(image api) new_image=$(answer EIGEN_API_IMAGE "$PINS")
    old=$(describe "$old_image")
    new=$(describe "$new_image")
    # What .env.production pins before the switch is what the rollback goes back to.
    old_pins=$(current_pins)

    API_IMAGE=$new_image
    before_stop
    # After the wait, which an interrupt may end: a backfill that adds a key writes .env.production anew, which the
    # running eigen-api would not read. Before the stop, so a failure leaves Eigen running.
    step "Adding what is new to .env.production" ".env.production has what Eigen $new needs" \
        "Could not update .env.production" cli configure --backfill
    # From the stop on, whatever ends the update starts Eigen again.
    AT_EXIT=restart
    stop
    step "Switching to Eigen $new" "Switched to Eigen $new" "Could not write Eigen $new into .env.production" \
        with_pins cli configure --backfill
    # Only a switch makes the backup the way back; an update without one leaves none to an older build. Its pins
    # follow, for a rollback that keeps the data.
    if [ -n "$saved" ]; then printf '%s\n%s\n' "$saved" "$old_pins" >.eigen/last-update; else rm -f .eigen/last-update; fi
    AT_EXIT=''
    restart "Fix what it says, then run ./eigen restart, or ./eigen rollback to go back to Eigen $old."
    step "Removing old images" "Old images removed" "Could not remove the old images" prune_images $old_pins
    say "$GREEN" '◇' "Eigen $old → $new is running at https://$domain/"
    if [ -n "$saved" ]; then
        say "$GRAY" '│' "Saved before the update: backups/$saved"
        say "$GRAY" '└' "./eigen rollback goes back to Eigen $old."
    else
        say "$GRAY" '└' "No backup was made before the update, so ./eigen rollback has nothing to go back to."
    fi
}

# Goes back to the build before the last update. switch_back keeps the data as it is when that build opens it. When
# it does not, the backup the update made brings back the data and .env.production, staged while Eigen runs, then the
# images it pins and their bundle files.
rollback() {
    yes=''
    help_flag rollback "$@"
    for arg in "$@"; do
        if in_argument rollback "$arg"; then continue; fi
        case $arg in
            --yes) yes=--yes ;;
            *) refuse rollback "$arg" ;;
        esac
    done
    need_in_time rollback
    if [ "$MODE" = local ]; then
        die "A local build has no update to roll back." "Go back in the code and run ./eigen setup again, which builds it."
    fi
    need_install
    wordmark rollback
    # First: a swap that was cut off, finished here, clears .eigen/last-update.
    preflight
    if [ ! -f .eigen/last-update ]; then
        no_rollback "There is no update to roll back." "./eigen rollback goes back after an ./eigen update."
    fi
    archive=$(sed -n 1p .eigen/last-update)
    if [ ! -f "backups/$archive" ]; then
        no_rollback "The backup the last update made, backups/$archive, is gone." \
            "./eigen rollback has nothing to go back to. To put back another backup: ./eigen restore <archive>"
    fi
    lock
    api_here
    current=$(describe "$(image api)")
    switch_back "$archive"
    if [ -n "$switched" ]; then return; fi
    say "$ACCENT" '◆' "Back from Eigen $current to the backup the last update made"
    s3=''
    where_archive "$archive"
    put_back
    say "$GREEN" '◇' "Eigen $current → $(describe "$API_IMAGE") is running at https://$(env_value DOMAIN)/"
    check_kept
}

# no_rollback <what went wrong> <what to do next>: a rollback's refusal, which points at the backups earlier updates
# made when there are any, since ./eigen restore puts one of them back.
no_rollback() {
    kept=$(pre_update_archives)
    if [ -z "$kept" ]; then die "$1" "$2"; fi
    say "$RED" '■' "$1" >&2
    say "$GRAY" '│' "The backups earlier updates made:" >&2
    printf '%s\n' "$kept" | while IFS= read -r archive; do say "$GRAY" '│' "  $archive" >&2; done
    say "$GRAY" '└' "./eigen restore <file> puts one of them back." >&2
    exit 1
}

# pre_update_archives: the backups updates made that retention kept in backups/, newest first by the stamp in the name.
pre_update_archives() {
    for archive in backups/server-pre-update-*.tar; do
        if [ -f "$archive" ]; then printf '%s\n' "${archive#backups/}"; fi
    done | awk -F- '{ print $(NF - 1) $NF, $0 }' | sort -r | cut -d' ' -f2-
}

# switch_back <archive>: the first way back, which keeps data/. The build before the update, as the API's user while
# Eigen runs, checks it opens every database here and asks; then the rollback warns the open tabs as put_back does,
# stops Eigen, checks again what Eigen wrote since (check_again) and switches back to the pins the update recorded.
# The archive stays for ./eigen restore. Sets switched once Eigen runs on that build. Leaves it empty, and says why,
# when that build cannot open the data: the rollback then puts the archive back. A check that stopped without a verdict
# on the data ends the rollback, which keeps today's data.
switch_back() {
    switched=''
    PINS=$(sed -n '2,$p' .eigen/last-update)
    old_image=$(answer EIGEN_API_IMAGE "$PINS")
    NEXT="Eigen $current runs on as it was. Check the network, then run ./eigen rollback again."
    step "Getting the build before the update" "The build before the update is here" \
        "Could not get the build before the update" \
        pull_refs $(printf '%s\n' "$PINS" | sed -n 's/^EIGEN_[A-Z]*_IMAGE=//p')
    NEXT=''
    old=$(describe "$old_image")
    say "$ACCENT" '◆' "Back from Eigen $current to Eigen $old, on the data as it is"
    # In ms, as check_again passes it. The margin covers a clock that differs between this host and Docker's VM.
    since=$((($(date +%s) - 300) * 1000))
    checked=0
    with_image "$old_image" cli_as 1000:1000 restore --check-data $yes || checked=$?
    # 130 is a Ctrl+C at its question, which the operator saw.
    case $checked in
        0) ;;
        "$CANNOT_OPEN")
            say "$YELLOW" '▲' "Eigen $old cannot open the data here."
            return
            ;;
        "$DECLINED") exit 0 ;;
        130) exit 130 ;;
        # The check could not run to the end, as when a database stays locked, Docker cannot run the image or the OOM
        # killer ends it: it said nothing of the data.
        *)
            die "The check stopped (exit $checked); Eigen $current runs on as it was." \
                "Fix what it says, then run ./eigen rollback again."
            ;;
    esac
    # After the pull, the check and its question, so the wait is the last thing before the stop.
    warn_restart rollback
    before_stop
    # From the stop on, whatever ends the rollback starts Eigen again, on the build .env.production pins by then.
    AT_EXIT=restart
    stop
    if ! check_again; then return; fi
    step "Switching to Eigen $old" "Switched to Eigen $old" "Could not write Eigen $old into .env.production" \
        with_image "$old_image" with_pins cli configure --backfill
    write_bundle "$old_image"
    # Only now, so a rollback cut off before here runs again and finishes.
    rm -f .eigen/last-update
    AT_EXIT=''
    restart
    say "$GREEN" '◇' "Eigen $current → $old is running at https://$(env_value DOMAIN)/"
    say "$GRAY" '└' "The data stayed as it was. backups/$1 stays, for ./eigen restore."
    switched=1
}

# check_again: with Eigen stopped, the build before the update checks once more the databases written since
# the first check began. The wait for the tabs and for a server backup ran on the new build, and a server backup opens
# every home, so a database may have moved to a schema the build before cannot open. Returns 1 when one did: Eigen
# stays stopped and the rollback puts the archive back. A check that stopped without a verdict ends the rollback, and
# Eigen starts again on the build it ran.
check_again() {
    say "$ACCENT" '◆' "Checking again what Eigen wrote since the first check"
    rechecked=0
    with_image "$old_image" cli_as 1000:1000 restore --check-data --yes --since "$since" || rechecked=$?
    case $rechecked in
        0) return 0 ;;
        "$CANNOT_OPEN")
            say "$YELLOW" '▲' "Eigen $old cannot open what Eigen $current wrote since the first check."
            return 1
            ;;
        *)
            die "The second check stopped (exit $rechecked); Eigen $current starts again." \
                "Fix what it says, then run ./eigen rollback again."
            ;;
    esac
}

COMMAND=${1:-}
if [ $# -gt 0 ]; then shift; fi
# dash runs the EXIT trap on an exit, not on a signal.
trap 'exit 130' INT TERM
case $COMMAND in
    setup) setup "$@" ;;
    status) status "$@" ;;
    update) update "$@" ;;
    rollback) rollback "$@" ;;
    restart | stop)
        arguments "$COMMAND" 0 "$@"
        need_install
        wordmark "$COMMAND"
        preflight
        lock
        # A restore that stopped writing the files, as its failure says, left those of the build before.
        if [ "$COMMAND" = restart ] && [ -n "$(stale_bundle)" ]; then write_bundle "$(image api)"; fi
        "$COMMAND"
        ;;
    reset-password)
        case ${1:-} in -h | --help) cli_help reset-password ;; esac
        need_install
        wordmark reset-password
        if ! api_running; then die "Eigen is not running." "Run ./eigen logs eigen-api to see why."; fi
        api_cli reset-password "$@"
        ;;
    backup) backup "$@" ;;
    restore) restore "$@" ;;
    logs)
        arguments logs 1 "$@"
        need_install
        if [ $# = 1 ] && ! dc config --services | grep -qx -- "$1"; then
            die "Eigen has no service \"$1\"." "Pick one of: $(dc config --services | paste -s -d , - | sed 's/,/, /g')."
        fi
        dc logs -f --tail 200 "$@"
        ;;
    help | -h | --help) usage ;;
    *)
        if [ -n "$COMMAND" ]; then printf 'Unknown command "%s".\n\n' "$COMMAND" >&2; fi
        usage >&2
        exit 2
        ;;
esac
