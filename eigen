#!/bin/sh
# Eigen's launcher. No container gets the Docker socket, so every Docker step runs here; the CLI in the API image asks
# the questions and writes the config. POSIX sh: runs under dash and BusyBox.
set -eu

# Through a symlink such as /usr/local/bin/eigen too, this runs in the install folder.
cd "$(dirname "$(readlink -f "$0")")"

REPO=https://github.com/eigen-is/eigen
REGISTRY=ghcr.io/eigen-is/eigen
# IMAGE_NAMES in apps/api/src/cli/install.ts. Not from compose config --images: that names the images of the
# profiles in use, and a release pins all five.
IMAGES='api frontend postfix dovecot unbound'
# The CLI's exit code for a question answered no: DECLINED in apps/api/src/cli/install.ts.
DECLINED=3
LOG=.eigen/last-step.log
# POSIX sleep only takes whole seconds; the spinner falls back to 1 where 0.2 fails.
TICK=0.2

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    ACCENT=$(printf '\033[1;36m') GREEN=$(printf '\033[32m') RED=$(printf '\033[31m')
    YELLOW=$(printf '\033[33m') GRAY=$(printf '\033[90m') RESET=$(printf '\033[0m')
else
    ACCENT='' GREEN='' RED='' YELLOW='' GRAY='' RESET=''
fi
usage() {
    cat <<EOF
Usage: ./eigen <command>

Commands:
  setup            Configure Eigen, start it and print the link that finishes the setup
  status           Report on Eigen, its services, disk space, snapshots and certificate
  update           Update Eigen to the newest version
  rollback         Go back to the version before the last update
  restart          Start Eigen, and any part of it that stopped
  stop             Stop Eigen; ./eigen restart starts it again
  reset-password   Set a new password for an account
  backup           Save Eigen as a snapshot in snapshots/
  restore          Put a snapshot back
  logs             Follow the logs
  help             Show this help

./eigen <command> --help tells more about one.

Environment:
  NO_COLOR=1       Plain output without color.
EOF
}

# The usage of the commands the launcher runs alone; the CLI prints its own for the others.
command_usage() {
    case $1 in
        status)
            cat <<EOF
Usage: ./eigen status

Reports on the version, a pending update, the services, disk space, the snapshots,
the certificate and the mail queue.
EOF
            ;;
        backup)
            cat <<EOF
Usage: ./eigen backup [--light] [--keep <n>]

Stops Eigen, saves data/ and .env.production as a full snapshot in snapshots/, and starts
Eigen again. Then deletes the older snapshots of that kind it made; --keep says how many
stay. Only the owner of this folder can read a snapshot.

  --light      Only the databases and config: every account's files and mail stay out
  --keep <n>   Keep the newest <n> snapshots of each kind
EOF
            ;;
        logs)
            cat <<EOF
Usage: ./eigen logs [service]

Follows the logs of every service, or of one.
EOF
            ;;
        update)
            cat <<EOF
Usage: ./eigen update [version] [--check] [--accept-breaking] [--full]

Updates Eigen to the newest release, or to <version>, and saves a snapshot first that
./eigen rollback goes back to: a light one, of the databases and config, unless the new
version lists breaking changes. A source install pulls the newest commit and builds it.
A release install can follow the main channel instead: ./eigen update main.

  --check             Only tell whether there is an update, and what it brings
  --accept-breaking   Update even when the new version lists breaking changes
  --full              Save a full snapshot, files and mail too
EOF
            ;;
        rollback)
            cat <<EOF
Usage: ./eigen rollback [--yes]

Goes back to the version before the last ./eigen update, with the data as it was then.
The current data is kept aside.

  --yes   Do not ask
EOF
            ;;
        restart)
            cat <<EOF
Usage: ./eigen restart

Starts Eigen, and any part of it that stopped.
EOF
            ;;
        stop)
            cat <<EOF
Usage: ./eigen stop

Stops Eigen. ./eigen restart starts it again.
EOF
            ;;
    esac
}

# refuse <command> <argument>: an argument the command does not take, with its usage.
refuse() {
    printf 'Unknown argument "%s".\n\n' "$2" >&2
    command_usage "$1" >&2
    exit 2
}

# arguments <command> <how many it takes> <argument…>: --help prints its usage; one argument too many is refused.
arguments() {
    command=$1 takes=$2
    shift 2
    for arg in "$@"; do
        case $arg in -h | --help)
            command_usage "$command"
            exit 0
            ;;
        esac
    done
    if [ $# -gt "$takes" ]; then
        shift "$takes"
        refuse "$command" "$1"
    fi
}

# The glyphs are GLYPHS in apps/api/src/cli/ui.ts, so the CLI's lines read like these.
say() { printf '%s%s%s  %s\n' "$1" "$2" "$RESET" "$3"; }

# die <what went wrong> <what to do next>
die() {
    say "$RED" '■' "$1" >&2
    say "$GRAY" '└' "$2" >&2
    exit 1
}

wordmark() { printf '\n%seigen|%s>%s\n\n' "$ACCENT" "$1" "$RESET"; }

# The last KEY= line of .env.production, without its quotes: the launcher reads no value that needs unescaping.
env_value() {
    value=$(sed -n "s/^$1=//p" .env.production 2>/dev/null | tail -n 1)
    case $value in
        \'*) value=${value#?}; value=${value%%\'*} ;;
        \"*) value=${value#?}; value=${value%%\"*} ;;
        *) value=${value%% #*} ;;
    esac
    printf '%s\n' "$value"
}

# answer <key> <the CLI's key=value lines>: the value it gave for that key.
answer() { printf '%s\n' "$2" | sed -n "s/^$1=//p" | tail -n 1; }

if [ -e .git ] && [ -f docker-compose.build.yml ]; then MODE=source; else MODE=release; fi

# The environment serves the folder the installer just made, which has no .env.production yet; an install's file is
# never overridden by a stray variable.
registry=$(env_value EIGEN_REGISTRY)
registry=${registry:-${EIGEN_REGISTRY:-}}
REGISTRY=${registry:-$REGISTRY}

image_key() { printf 'EIGEN_%s_IMAGE\n' "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"; }

# image <name>: the image Compose runs for it, as the environment or .env.production names it, else a source build's.
image() {
    key=$(image_key "$1")
    eval "ref=\${$key:-}"
    ref=${ref:-$(env_value "$key")}
    printf '%s\n' "${ref:-$REGISTRY/$1:local}"
}

API_IMAGE=$(image api)

# Compose interpolates the build overlay for every command, so a source install always exports these.
source_env() {
    BUN_VERSION=$(cat .bun-version)
    EIGEN_VERSION=$(sed -n 's/^  "version": "\(.*\)",$/\1/p' package.json | head -n 1)
    EIGEN_COMMIT=$(git -c safe.directory="$PWD" rev-parse --short HEAD 2>/dev/null || true)
    EIGEN_BUILT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    export BUN_VERSION EIGEN_VERSION EIGEN_COMMIT EIGEN_BUILT_AT
}
if [ "$MODE" = source ]; then source_env; fi

dc() {
    if [ -f docker-compose.override.yml ]; then set -- -f docker-compose.override.yml "$@"; fi
    if [ "$MODE" = source ]; then set -- -f docker-compose.build.yml "$@"; fi
    docker compose --env-file .env.production -f docker-compose.yml "$@"
}

# PROJECT: the Compose project, named the way Compose names it. Asked once, before the steps that use it, which run in
# subshells and would each ask again.
PROJECT=''
project() {
    if [ -z "$PROJECT" ]; then PROJECT=$(dc config 2>/dev/null | sed -n 's/^name: //p'); fi
}

# Whom a root run of the CLI gives what it writes: through Docker Desktop's file share, root in a container sees root.
EIGEN_OWNER=$(ls -ldn . | awk '{ print $3 ":" $4 }')
export EIGEN_OWNER

# cli_as <uid:gid> <command…>: the CLI in the API image on this folder, with the variables CLI_ENV names. A terminal on
# stdin gets one in the container, or a typed password would echo; asked per call, as step runs its command on /dev/null.
CLI_ENV=''
cli_as() {
    user=$1
    shift
    env='' tty=''
    for name in $CLI_ENV; do env="$env -e $name"; done
    if [ -t 0 ]; then tty=-t; fi
    docker run --rm --init -i $tty -e TERM -e NO_COLOR -e EIGEN_OWNER $env --user "$user" -e HOME=/tmp \
        -v "$PWD:/install" -w /install "$API_IMAGE" "$@"
}

# The CLI as the operator, so what it writes is theirs.
cli() { cli_as "$(id -u):$(id -g)" "$@"; }

# The CLI in the running API container, the only way to its control socket.
api_cli() {
    tty=''
    if [ ! -t 0 ]; then tty=-T; fi
    dc exec $tty -e TERM -e NO_COLOR eigen-api /app/docker/api/entrypoint.sh "$@"
}

# step <while running> <when done> <on failure> <command…>: one line per step, its output in $LOG, under a spinner on a
# terminal. set -m gives the job its own process group, so Ctrl-C stops all of it.
step() {
    step_running=$1 step_done=$2 step_failed=$3
    shift 3
    code=0
    if [ -t 1 ]; then
        set -m
        (set +e; "$@") >"$LOG" 2>&1 </dev/null &
        job=$!
        set +m
        trap 'kill -s TERM -- "-$job" 2>/dev/null || :; wait "$job" 2>/dev/null || :; printf "\r\033[K\033[1A\r\033[K\033[?25h"
            say "$RED" "■" "$step_running: cancelled." >&2; exit 130' INT TERM
        started=$(date +%s)
        frame=0
        printf '\033[?25l\n'
        while kill -0 "$job" 2>/dev/null; do
            case $((frame % 4)) in 0) glyph=◒ ;; 1) glyph=◐ ;; 2) glyph=◓ ;; *) glyph=◑ ;; esac
            frame=$((frame + 1))
            seconds=$(($(date +%s) - started))
            elapsed=${seconds}s
            if [ "$seconds" -ge 60 ]; then elapsed="$((seconds / 60))m $((seconds % 60))s"; fi
            width=$(stty size </dev/tty 2>/dev/null || :)
            width=${width#* }
            case $width in '' | 0 | *[!0-9]*) width=80 ;; esac
            # A wrapped line would break the redraw. BuildKit's "#12 3.45 …" loses its step number and timestamp.
            line=$(tail -n 20 "$LOG" 2>/dev/null | awk -v width=$((width - 4)) '{
                sub(/.*\r/, ""); gsub(/\033\[[0-9;?]*[A-Za-z]/, ""); gsub(/[[:cntrl:]]/, " ")
                sub(/^#[0-9]+ ([0-9]+\.[0-9]+ )?/, "")
            } NF && !/^(DONE [0-9.]+s|CACHED)$/ { line = $0 } END { print substr(line, 1, width) }')
            printf '\r\033[K\033[1A\r\033[K%s%s%s  %s...  %s%s%s\n\033[K%s│  %s%s' "$ACCENT" "$glyph" "$RESET" \
                "$step_running" "$GRAY" "$elapsed" "$RESET" "$GRAY" "$line" "$RESET"
            sleep "$TICK" 2>/dev/null || TICK=1
        done
        wait "$job" 2>/dev/null || code=$?
        trap 'exit 130' INT TERM
        printf '\r\033[K\033[1A\r\033[K\033[?25h'
    else
        "$@" >"$LOG" 2>&1 </dev/null || code=$?
    fi
    if [ "$code" = 0 ]; then
        say "$GREEN" '◇' "$step_done"
        return 0
    fi
    {
        say "$RED" '■' "$step_failed"
        tail -n 20 "$LOG" | sed "s/^/${GRAY}│${RESET}  /"
        say "$GRAY" '└' "Full output: $LOG. ${NEXT:-Fix what it says, then run ./eigen $COMMAND again.}"
    } >&2
    exit 1
}

# compose_at_least <have> <want>: Compose versions like 2.24.4, number by number. Eigen's own versions the CLI orders.
compose_at_least() {
    awk -v have="$1" -v want="$2" 'BEGIN {
        split(have, h, "."); split(want, w, ".")
        for (i = 1; i <= 3; i++) if (h[i] + 0 != w[i] + 0) exit !(h[i] + 0 > w[i] + 0)
    }'
}

preflight() {
    if [ -e .env.production ] && [ ! -r .env.production ]; then
        die ".env.production is not readable by this user." "Run ./eigen as the user that owns it, or as root."
    fi
    server=$(docker info --format '{{.ServerVersion}} {{.Architecture}}' 2>/dev/null || true)
    if [ -z "${server%% *}" ]; then
        die "Docker is not running, or this user cannot use it." "Start Docker, or run ./eigen as root or a member of the docker group."
    fi
    compose=$(docker compose version --short 2>/dev/null || true)
    compose=${compose#v}
    if [ -z "$compose" ]; then
        die "Docker Compose is not installed." "Install the Docker Compose plugin, version 2.20 or newer."
    fi
    need=2.20
    if [ -f docker-compose.override.yml ] && grep -q '!override' docker-compose.override.yml; then need=2.24.4; fi
    # Docker Desktop's 2.24.4-desktop.1 is 2.24.4, no prerelease.
    if ! compose_at_least "${compose%%-*}" "$need"; then
        die "Docker Compose $compose is too old for this install; it needs $need or newer." "Update the Docker Compose plugin, then run ./eigen $COMMAND again."
    fi
    arch=${server#* }
    mkdir -p .eigen
    say "$GREEN" '◇' "Docker ${server%% *} on $arch, Compose $compose"
}

# Configure always writes DOMAIN; an unreadable .env.production is for preflight to report.
need_install() {
    if [ ! -e .env.production ] || { [ -r .env.production ] && [ -z "$(env_value DOMAIN)" ]; }; then
        die "Eigen is not set up in $PWD." "Run ./eigen setup first."
    fi
}

# need_image <what to do>: the CLI comes with the API image, which a source install builds in ./eigen setup.
need_image() {
    if [ "$MODE" = source ] && ! docker image inspect "$API_IMAGE" >/dev/null 2>&1; then
        die "Eigen is not built yet." "$1"
    fi
}

# Git run by another user would leave objects in .git that its owner cannot write.
need_git_owner() {
    if [ ! -O .git ]; then die "This checkout belongs to another user." "Run ./eigen $COMMAND as the owner of $PWD/.git."; fi
}

# One command that changes Eigen at a time, or a nightly backup could stop Eigen in the middle of an update. The lock
# goes when the command ends, after AT_EXIT; update --pulled finds its own, handed over by exec.
AT_EXIT=''
lock() {
    if ! mkdir .eigen/lock 2>/dev/null; then
        pid=$(cat .eigen/lock/pid 2>/dev/null || :)
        # The lock of a process that is gone is taken over.
        if [ -n "$pid" ] && [ "$pid" != $$ ] && kill -0 "$pid" 2>/dev/null; then
            die "Another ./eigen command is running." "Wait for it to end, then run ./eigen $COMMAND again."
        fi
        # Another user's process cannot be asked whether it runs, and their lock cannot be taken over.
        if [ ! -w .eigen/lock ]; then
            holder=$(ls -ld .eigen/lock | awk '{ print $3 }')
            die "Another ./eigen command, run by $holder, holds .eigen/lock." "Wait for it to end, then run ./eigen $COMMAND again. If none runs, remove .eigen/lock as $holder or as root."
        fi
    fi
    trap 'code=$?; (eval "$AT_EXIT") || code=$?; rm -rf .eigen/lock; exit "$code"' EXIT
    echo $$ >.eigen/lock/pid
}

# cli_help <CLI command>: the usage of a command the CLI parses.
cli_help() {
    need_image "Run ./eigen setup first; ./eigen $COMMAND --help works after that."
    cli "$1" --help
    exit
}

# A build is an api image, named by its labels as <version> (<revision>) on every install. EIGEN_VERSION says what an
# install follows: main, the one channel, or the release it was pinned to, which follows latest.

# image_label <image> <version or revision>: that label of a local image.
image_label() { docker image inspect --format "{{index .Config.Labels \"org.opencontainers.image.$2\"}}" "$1"; }

# release_label <tag> <version or revision>: that annotation of the registry's api:<tag>, without a pull; empty without
# one.
release_label() {
    docker manifest inspect -v "$REGISTRY/api:$1" 2>/dev/null |
        sed -n "s/.*\"org\.opencontainers\.image\.$2\": *\"\([^\"]*\)\".*/\1/p" | head -n 1
}

# describe <api image>: the build it is, as every message names one. Its die ends only the $(…): assign it bare.
describe() {
    label=$(image_label "$1" version 2>/dev/null) ||
        die "$1 is not here." "Run ./eigen update again; it downloads what it runs."
    echo "$label ($(image_label "$1" revision))"
}

# pull_images <tag> [name…]: its images, all five by default. Not $tag, which is update_get's.
pull_images() {
    pulling=$1
    shift
    for name in ${*:-$IMAGES}; do docker pull "$REGISTRY/$name:$pulling" || return 1; done
}

# pull_refs <image…>: those not here yet, such as the digests a snapshot pins.
pull_refs() {
    for ref in "$@"; do docker image inspect "$ref" >/dev/null 2>&1 || docker pull "$ref" || return 1; done
}

# pin_images <tag>: PINS, the release as configure writes it, a key=value line each, every image by its registry
# digest. A tag moves image by image while a build is published, so its five images must name one commit.
PINS=''
pin_images() {
    builds='' first='' mixed=''
    for name in $IMAGES; do
        revision=$(image_label "$REGISTRY/$name:$1" revision)
        if [ -z "$builds" ]; then first=$revision; elif [ "$revision" != "$first" ]; then mixed=1; fi
        builds="${builds:+$builds, }$name $revision"
    done
    if [ -n "$mixed" ]; then
        die "The images of $1 are from different builds: $builds." "A build of $1 is being published; run ./eigen $COMMAND again in a few minutes."
    fi
    PINS="EIGEN_REGISTRY=$REGISTRY
EIGEN_VERSION=$1"
    for name in $IMAGES; do
        digest=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' \
            "$REGISTRY/$name:$1" | grep -F "$REGISTRY/$name@" | head -n 1)
        if [ -z "$digest" ]; then
            die "$REGISTRY/$name:$1 has no registry digest." "Remove the local image (docker image rm $REGISTRY/$name:$1) and run ./eigen $COMMAND again."
        fi
        PINS="$PINS
$(image_key "$name")=$digest"
    done
}

# with_pins <command…>: runs it with PINS in its environment and the CLI's, where configure writes them from; out of
# the launcher's own, since Compose prefers the environment to .env.production.
with_pins() (
    for pin in $PINS; do
        export "$pin"
        CLI_ENV="$CLI_ENV ${pin%%=*}"
    done
    "$@"
)

# The api image .env.production pins, downloaded when it is not here: a pull that moves main leaves the build it
# replaced without a local name.
api_here() {
    pull_refs "$(image api)" >"$LOG" 2>&1 ||
        die "The image Eigen runs, $(image api), is not here and cannot be downloaded." "Check the network, then run ./eigen $COMMAND again."
}

commits_behind() {
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes' git fetch --quiet &&
        git rev-list --count 'HEAD..@{upstream}'
}

# The source images, built under -next names: the running ones keep theirs until the snapshot is saved.
build_next() (
    for name in $IMAGES; do export "$(image_key "$name")=$(image "$name")-next"; done
    dc build
)

switch_images() {
    for name in $IMAGES; do
        ref=$(image "$name")
        if docker image inspect "$ref-next" >/dev/null 2>&1; then
            docker tag "$ref-next" "$ref" && docker image rm "$ref-next" || return 1
        fi
    done
}

# Also removes this project's containers whose service the current profiles leave out, so a rerun that switches web
# or mail mode converges. Runs under step with set -e off, so failures return explicitly.
start() {
    services=$(dc config --services) || return 1
    active=" $(printf '%s ' $services)"
    project
    stale=$(docker ps -a --filter "label=com.docker.compose.project=$PROJECT" \
        --format '{{.ID}} {{.Label "com.docker.compose.service"}}' | while read -r id service; do
        case $active in (*" $service "*) ;; (*) echo "$id" ;; esac
    done)
    if [ -n "$stale" ]; then docker rm -f $stale || return 1; fi
    dc up -d --wait
}

# restart [what to do on failure]: once a command has stopped Eigen or changed it, running it again would repeat that,
# so a failed start points at ./eigen restart.
restart() {
    NEXT=${1:-Fix what it says, then run ./eigen restart.}
    project
    mail=$(mail_containers)
    step "Starting Eigen" "Eigen is running" "Eigen did not start; ./eigen logs shows why" start
    if [ "$(mail_containers)" != "$mail" ]; then refresh_fail2ban; fi
}

# Every container of this project, also those of services the current files no longer name.
stop_containers() {
    dc stop || return 1
    project
    ids=$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT")
    if [ -n "$ids" ]; then docker stop $ids; fi
}

stop() {
    project
    step "Stopping Eigen" "Eigen stopped" "Could not stop Eigen" stop_containers
}

# check_room <snapshot flags…>: KIND, the snapshot those flags save, once the CLI found room for it. Asked while Eigen
# runs, so a full disk stops nothing.
KIND=''
check_room() {
    step "Checking the room for the snapshot" "Room for the snapshot" "The snapshot cannot be saved" \
        cli_as 0 snapshot --check "$@"
    KIND=$(answer kind "$(cat "$LOG")")
}

# The server runs as 1000:1000. Only an empty folder is handed over: an existing one keeps its owners.
prepare_data() {
    mkdir -p data backups || return 1
    for dir in data backups; do
        if [ -z "$(ls -A "$dir" 2>/dev/null || echo unreadable)" ]; then
            docker run --rm --user 0 --entrypoint chown -v "$PWD/$dir:/$dir" "$API_IMAGE" 1000:1000 "/$dir" || return 1
        fi
    done
    docker run --rm --user 1000:1000 --entrypoint sh -v "$PWD/data:/data" -v "$PWD/backups:/backups" "$API_IMAGE" \
        -c 'for dir in /data /backups; do touch "$dir/.eigen-write-test" && rm "$dir/.eigen-write-test" || exit 1; done' || {
        echo "Eigen runs as uid 1000 and cannot write here. Give it the folders: sudo chown 1000:1000 data backups"
        return 1
    }
}

# pull_pinned <restore --checked lines>: the images the checked snapshot pins, got while Eigen runs on.
pull_pinned() {
    refs=''
    for name in $IMAGES; do
        ref=$(answer "$(image_key "$name")" "$1")
        if [ -z "$ref" ]; then
            die "The snapshot pins no $name image." "Restore a snapshot made by ./eigen backup on a release install."
        fi
        refs="$refs $ref"
    done
    version=$(answer EIGEN_VERSION "$1")
    step "Getting Eigen $version" "Eigen $version is here" "Could not get Eigen $version; Eigen runs on as it was" \
        pull_refs $refs
}

# check_snapshot <restore arguments…>: while Eigen runs, the CLI asks, then unpacks and checks the snapshot into
# .eigen/restore. A no ends the command; a refusal stops nothing.
check_snapshot() {
    # The CLI says how an interrupt ended it, so the launcher waits for it.
    trap : INT TERM
    checked=0
    cli_as 0 restore "$@" --check || checked=$?
    trap 'exit 130' INT TERM
    case $checked in 0) ;; "$DECLINED") exit 0 ;; *) exit "$checked" ;; esac
    # Until the swap, root's checked copy of data/ is root's to remove: STAGING in apps/api/src/cli/snapshot.ts.
    AT_EXIT='cli_as 0 rm -rf .eigen/restore'
}

# swap_snapshot <restore arguments…>: stops Eigen and swaps the checked copy in. A failed swap starts Eigen on the data
# it had and ends the command; after a swap, whatever ends the command starts Eigen.
swap_snapshot() {
    AT_EXIT='cli_as 0 rm -rf .eigen/restore; restart'
    if [ -f .env.production ]; then stop; fi
    trap : INT TERM
    swapped=0
    cli_as 0 restore "$@" --yes || swapped=$?
    trap 'exit 130' INT TERM
    if [ "$swapped" = 0 ]; then
        AT_EXIT=restart
        return
    fi
    AT_EXIT='cli_as 0 rm -rf .eigen/restore'
    restart
    if [ "$swapped" = 130 ]; then say "$GRAY" '└' "The restore was cancelled. Eigen runs on the data it had."; fi
    exit "$swapped"
}

# The IDs of the mail containers, stopped ones too: fail2ban's jails follow their logs by container ID.
mail_containers() {
    docker ps -a --filter "label=com.docker.compose.project=$PROJECT" \
        --format '{{.ID}} {{.Label "com.docker.compose.service"}}' | grep -E ' (postfix|dovecot)$' || :
}

# After a start that recreated the mail containers. The filters come with Eigen, the jail is the operator's.
refresh_fail2ban() {
    jail=/etc/fail2ban/jail.d/eigen-mail-sasl.conf
    if [ ! -e "$jail" ]; then return 0; fi
    filters="$PWD/docker/fail2ban/filter.d"
    if [ -w "$jail" ] && command -v fail2ban-client >/dev/null && cp "$filters"/*.conf /etc/fail2ban/filter.d/ &&
        fail2ban-client reload >/dev/null 2>&1; then
        say "$GREEN" '◇' "Fail2ban filters refreshed and jails reloaded"
    else
        say "$YELLOW" '▲' "Fail2ban still watches the old mail containers. As root, run:"
        say "$GRAY" '│' "cp $filters/*.conf /etc/fail2ban/filter.d/ && fail2ban-client reload"
    fi
}

# prune_images: the images an update leaves behind. A release install keeps the images PINS names and those the
# rollback snapshot pins (KEEP), and removes the rest by ID: an old build of main keeps no tag, only its digest,
# which no prune takes. Best effort.
KEEP=''
prune_images() {
    label=org.opencontainers.image.source=$REPO
    if [ "$MODE" = release ]; then
        keep=' '
        for ref in $KEEP $PINS; do keep="$keep${ref#*=} "; done
        for name in $IMAGES; do
            remove=$(docker image ls "$REGISTRY/$name" --digests \
                --format '{{.ID}} {{.Repository}}@{{.Digest}} {{.Repository}}:{{.Tag}}' | awk -v keep="$keep" '
                { ids[$1]; if (index(keep, " " $2 " ") || index(keep, " " $3 " ")) kept[$1] }
                END { for (id in ids) if (!(id in kept)) print id }')
            if [ -n "$remove" ]; then docker image rm -f $remove || :; fi
        done
        docker image prune -f --filter "label=$label" || :
    else
        project
        docker image prune -f --filter "label=$label" --filter "label=com.docker.compose.project=$PROJECT" || :
        # Host-wide, but only build cache older than a week.
        docker builder prune -f --filter until=168h || :
    fi
}

# write_bundle <api image>: a release install's launcher and Compose files, as that api image writes them. Written to
# temporary files and renamed, so this running launcher reads on in its own copy. .eigen/bundle names the image first,
# so status can tell files of one build from a server that still runs another.
write_bundle() {
    build=$(describe "$1")
    API_IMAGE=$1
    echo "$1" >.eigen/bundle
    step "Writing the Eigen $build launcher and Compose files" "Eigen $build files written" \
        "Could not write the Eigen $build files" cli bootstrap --force --out /install
}

setup() {
    case ${1:-} in -h | --help) cli_help configure ;; esac
    # The variable --relay-password-env names goes into the CLI's container; the CLI refuses a name that is none.
    relay=''
    previous=''
    for arg in "$@"; do
        case $previous in --relay-password-env) relay=$arg ;; esac
        case $arg in --relay-password-env=*) relay=${arg#*=} ;; esac
        previous=$arg
    done
    CLI_ENV="EIGEN_PROJECT EIGEN_DOCKER_NETWORKS $relay"

    version=$(env_value EIGEN_VERSION)
    # The installer leaves the launcher alone here. The release .env.production names, else the newest, writes its
    # files, and its launcher takes over, the lock with it, as update --pulled does.
    if [ "$MODE" = release ] && [ ! -e docker-compose.yml ]; then
        preflight >/dev/null
        lock
        API_IMAGE=$REGISTRY/api:${version:-latest}
        step "Downloading Eigen" "Eigen downloaded" "Could not download Eigen" docker pull "$API_IMAGE"
        step "Writing the Eigen files" "Eigen files written" "Could not write the Eigen files" \
            cli bootstrap --force --out /install
        exec ./eigen setup "$@"
    fi
    wordmark setup
    preflight
    lock
    if [ "$MODE" = source ]; then
        # Compose loads env_file: even to build.
        if [ ! -e .env.production ]; then (umask 077 && : >.env.production); fi
        step "Building Eigen" "Eigen built" "Could not build Eigen" dc build eigen-api
    else
        if [ -z "$version" ]; then
            die ".env.production names no Eigen release." "Get one into it: docker run --rm -v \"\$PWD:/out\" $REGISTRY/api:latest bootstrap --force"
        fi
        # A tag is resolved to digests once, by the first setup or by update: a rerun gets the images already pinned.
        case $(image api) in
            *@sha256:*)
                refs=$(for name in $IMAGES; do image "$name"; done)
                step "Downloading Eigen $version" "Eigen $version downloaded" "Could not download Eigen $version" \
                    pull_refs $refs
                ;;
            *)
                step "Downloading Eigen $version" "Eigen $version downloaded" "Could not download Eigen $version" \
                    pull_images "$version"
                pin_images "$version"
                ;;
        esac
        API_IMAGE=$(image api)
    fi

    # configure picks a free subnet from this list; the CLI container cannot ask Docker itself.
    docker network inspect $(docker network ls -q) >.eigen/networks.json ||
        die "Could not list the Docker networks." "Check that Docker is running, then run ./eigen setup again."
    EIGEN_DOCKER_NETWORKS=/install/.eigen/networks.json
    project
    EIGEN_PROJECT=$PROJECT
    export EIGEN_DOCKER_NETWORKS EIGEN_PROJECT
    with_pins cli configure "$@" || exit

    if [ "$MODE" = source ]; then
        step "Building the web and mail images" "Images built" "Could not build the images" \
            dc build $(dc config --services | grep -vx eigen-api)
    fi
    step "Preparing data/ and backups/" "Data folders ready" "The data folders are not writable" prepare_data
    restart "Fix what it says, then run ./eigen setup again."
    api_cli setup-link
}

# Only the launcher can ask Docker and read snapshots/; with Eigen down there is no socket, and the CLI runs on its own.
status() {
    arguments status 0 "$@"
    need_install
    wordmark status
    preflight >/dev/null
    # Empty when the check fails, no flag when it cannot run.
    newer=''
    if [ "$MODE" = release ]; then
        if [ "$(env_value EIGEN_VERSION)" = main ]; then
            newer="--latest=$(release_label main revision)"
        else
            newer="--latest=$(release_label latest version)"
        fi
    # Another user's fetch would leave objects in .git that its owner cannot write.
    elif [ -O .git ] && git rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1; then
        newer="--new-commits=$(commits_behind 2>/dev/null || :)"
    fi
    tab=$(printf '\t')
    listed=$(dc ps -a --format "{{.Service}}$tab{{.State}}$tab{{.Health}}") ||
        die "Could not read the state of the services." "Fix what Docker Compose says above, then run ./eigen status again."
    services=''
    for service in $(dc config --services); do
        line=$(printf '%s\n' "$listed" | grep "^$service$tab" | head -n 1)
        services="$services${line:-$service${tab}missing$tab}
"
    done

    # Empty when postqueue fails; the CLI tells that from a stopped postfix by the service list.
    queue=''
    case $services in *"postfix${tab}running$tab"*)
        queue=$(dc exec -T postfix postqueue -p 2>/dev/null | tail -n 1)
        ;;
    esac

    set -- --services="$services" --mail-queue="$queue" --snapshots="$(ls snapshots 2>/dev/null || :)" \
        --snapshots-kb="$(du -sk snapshots 2>/dev/null | cut -f 1)" ${newer:+"$newer"}
    bundle=$(cat .eigen/bundle 2>/dev/null || :)
    if [ -n "$bundle" ] && [ "$bundle" != "$(image api)" ]; then
        files=$(describe "$bundle")
        set -- "$@" --files="$files"
    fi
    case $services in
        *"eigen-api${tab}running$tab"*) api_cli status "$@" ;;
        *) cli status "$@" ;;
    esac
}

# The snapshot is taken with every service stopped, since dovecot and postfix write to data/ too. The CLI reads the
# flags, and refuses a --keep that is no count, before anything stops.
backup() {
    previous=''
    for arg in "$@"; do
        case $previous in --keep) previous='' && continue ;; esac
        case $arg in
            -h | --help)
                command_usage backup
                exit 0
                ;;
            --light | --keep | --keep=*) ;;
            *) refuse backup "$arg" ;;
        esac
        previous=$arg
    done
    need_install
    wordmark backup
    preflight
    lock
    check_room "$@"
    AT_EXIT=restart
    stop
    cli_as 0 snapshot "$@"
}

restore() {
    case ${1:-} in -h | --help) cli_help restore ;; esac
    # The CLI sees this folder as /install.
    case ${1:-} in "$PWD"/snapshots/*)
        snapshot=${1#"$PWD"/}
        shift
        set -- "$snapshot" "$@"
        ;;
    esac
    wordmark restore
    preflight
    need_image "Run ./eigen setup first, then ./eigen restore <snapshot>."
    if [ "$MODE" = release ]; then api_here; fi
    lock
    check_snapshot "$@"
    # A snapshot holds the server's config and databases: a release install goes back to the images it pins.
    pins=''
    if [ "$MODE" = release ]; then
        pins=$(cli_as 0 restore "$@" --checked </dev/null)
        if [ "$(answer EIGEN_API_IMAGE "$pins")" = "$(image api)" ]; then pins=''; fi
    fi
    if [ -n "$pins" ]; then pull_pinned "$pins"; fi
    swap_snapshot "$@"
    # A release install runs the Compose files of the snapshot's version; a source install runs today's, which may need
    # keys an older snapshot lacks.
    if [ "$MODE" = source ]; then
        step "Adding what is new to .env.production" ".env.production has what Eigen needs" \
            "Could not update .env.production" cli configure --backfill
    fi
    if [ -n "$pins" ]; then write_bundle "$(answer EIGEN_API_IMAGE "$pins")"; fi
    AT_EXIT=''
    restart
    say "$GRAY" '└' "Check that all is well, then delete what was kept aside."
}

update() {
    target='' check=0 accept='' pulled=0 full='' light=--light
    for arg in "$@"; do
        case $arg in
            -h | --help)
                command_usage update
                exit 0
                ;;
            --check) check=1 ;;
            --accept-breaking) accept=--accept-breaking ;;
            --full) full=--full light='' ;;
            # The handover from the launcher that got the new version to the one that came with it.
            --pulled) pulled=1 ;;
            -*) refuse update "$arg" ;;
            *) if [ -n "$target" ]; then refuse update "$arg"; fi; target=$arg ;;
        esac
    done
    need_install
    if [ "$pulled" = 1 ]; then
        preflight >/dev/null
    else
        wordmark update
        preflight
    fi
    if [ "$MODE" = source ]; then need_git_owner; fi
    if [ "$check" = 0 ]; then lock; fi
    if [ "$pulled" = 1 ]; then update_apply; else update_get; fi
}

# The part the launcher the operator typed runs, while Eigen runs on: get the new version, check it, and hand over to
# the launcher that came with it.
update_get() {
    if [ "$MODE" = source ]; then
        if [ -n "$target" ]; then
            die "A source install updates to the newest commit; it takes no version." "Run ./eigen update."
        fi
        upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) ||
            die "This checkout follows no branch." "Set one with git branch --set-upstream-to origin/main, then run ./eigen update again."
        if [ "$check" = 1 ]; then
            behind=$(commits_behind 2>"$LOG") ||
                die "Could not fetch $upstream: $(tail -n 1 "$LOG")" "Check the network, then run ./eigen update --check again."
            if [ "$behind" = 0 ]; then
                say "$GREEN" '◇' "Eigen is up to date with $upstream."
                exit 0
            fi
            say "$YELLOW" '▲' "$behind new commit$([ "$behind" = 1 ] || echo s) on $upstream:"
            git log --format='%h %s' 'HEAD..@{upstream}' | head -n 10 | sed "s/^/${GRAY}│${RESET}  /"
            say "$GRAY" '└' "./eigen update installs $([ "$behind" = 1 ] && echo it || echo them)."
            exit 0
        fi
        before=$(git rev-parse HEAD)
        if ! git pull --ff-only >"$LOG" 2>&1; then
            if grep -q 'would be overwritten' "$LOG"; then
                files=$(sed -n "s/^$(printf '\t')//p" "$LOG" | tr '\n' ' ')
                die "Local changes are in the way of the update: $files" "Keep them with git stash, or drop them with git checkout -- <file>; then run ./eigen update again."
            elif grep -qi 'fast-forward' "$LOG"; then
                die "This checkout has commits that $upstream does not have." "Put them on top with git rebase $upstream, or drop them with git reset --hard $upstream; then run ./eigen update again."
            fi
            die "Could not pull $upstream: $(tail -n 1 "$LOG")" "Fix what it says, then run ./eigen update again. Full output: $LOG."
        fi
        count=$(git rev-list --count "$before..HEAD")
        if [ "$count" = 0 ]; then
            say "$GREEN" '◇' "No new commits on $upstream"
        else
            say "$GREEN" '◇' "Pulled $count new commit$([ "$count" = 1 ] || echo s) from $upstream"
        fi
        exec ./eigen update --pulled $full
    fi

    # main is the only channel; any other tag, such as publish.yml's candidates, is no release.
    case $target in
        '' | latest | main | [0-9]*.[0-9]*.[0-9]*) ;;
        *) die "Eigen has no \"$target\"." "Name a version (./eigen update 0.3.1), latest, or the main channel (./eigen update main)." ;;
    esac
    follows=$(env_value EIGEN_VERSION)
    if [ -z "$follows" ]; then die ".env.production names no Eigen release." "Run ./eigen setup first."; fi
    api_here
    current=$(describe "$(image api)")
    # Release notes and the breaking question go by version.
    old_version=$(image_label "$(image api)" version)
    tag=${target:-latest}
    if [ -z "$target" ] && [ "$follows" = main ]; then tag=main; fi
    version=$(release_label "$tag" version) revision=$(release_label "$tag" revision)
    if [ -z "$version" ]; then
        # Without the annotations, the image's labels name the build.
        step "Looking for Eigen ${target:-updates}" "Found Eigen ${target:-updates}" \
            "Could not get Eigen ${target:-updates}. Releases: $REPO/releases" docker pull "$REGISTRY/api:$tag"
        version=$(image_label "$REGISTRY/api:$tag" version) revision=$(image_label "$REGISTRY/api:$tag" revision)
        if [ -z "$version" ]; then
            die "$REGISTRY/api:$tag names no version." "Name one: ./eigen update <version>. Releases: $REPO/releases"
        fi
    fi
    # latest moves on, so the install records the release it names.
    new="$version ($revision)" record=$tag
    if [ "$tag" = latest ]; then record=$version; fi
    # Up to date: the same build, on the line the install already follows.
    if [ "$new" = "$current" ] && [ "$record" = "$follows" ]; then
        if [ "$check" = 1 ]; then
            say "$GRAY" '└' "Eigen $current is up to date."
            exit 0
        fi
        # An update that stopped halfway, to whatever target, left the files of another build.
        bundle=$(cat .eigen/bundle 2>/dev/null || :)
        if [ -n "$bundle" ] && [ "$bundle" != "$(image api)" ]; then write_bundle "$(image api)"; fi
        restart
        say "$GRAY" '└' "Eigen $current is up to date and running at https://$(env_value DOMAIN)/"
        exit 0
    fi
    # The new version's CLI tells what changed since the old one, and refuses a downgrade.
    API_IMAGE=$REGISTRY/api:$record
    step "Getting the notes of Eigen $new" "Eigen $new is out" "Could not get Eigen $new" pull_images "$record" api
    # The tag may have moved since the manifest was read.
    new=$(describe "$REGISTRY/api:$record")
    if [ "$check" = 1 ]; then
        cli update-check --from "$old_version" --accept-breaking
        say "$GRAY" '└' "./eigen update installs it."
        exit 0
    fi
    checked=0
    cli update-check --from "$old_version" $accept || checked=$?
    case $checked in 0) ;; "$DECLINED") exit 0 ;; *) exit "$checked" ;; esac
    step "Downloading Eigen $new" "Eigen $new downloaded" "Could not download Eigen $new" pull_images "$record"
    # Before the files of the new version, which a failure would leave with the old images. A breaking release gets a
    # full snapshot, since it may convert what a light one leaves out.
    pin_images "$record"
    check_room $light --from "$old_version"
    if [ "$KIND" = full ]; then full=--full; fi
    write_bundle "$(answer EIGEN_API_IMAGE "$PINS")"
    exec ./eigen update --pulled "$record" $full
}

# The part the launcher of the new version runs: stop, save a snapshot with the running version, switch and start.
update_apply() {
    domain=$(env_value DOMAIN)
    if [ ! -d data ]; then die "There is no data/ in $PWD." "Run ./eigen update in the install folder."; fi
    if [ "$MODE" = source ]; then
        container=$(dc ps -a -q eigen-api 2>/dev/null | head -n 1)
        old_image=$API_IMAGE old=''
        if [ -n "$container" ]; then
            old_image=$(docker inspect --format '{{.Image}}' "$container")
            old=$(describe "$old_image")
        fi
        new="$EIGEN_VERSION ($EIGEN_COMMIT)"
        if [ "$old" = "$new" ]; then
            restart
            say "$GRAY" '└' "Eigen $new is up to date and running at https://$domain/"
            exit 0
        fi
        step "Building Eigen $new" "Eigen $new built" "Could not build Eigen $new; Eigen runs on as it was" build_next
        new_image=$API_IMAGE-next
        API_IMAGE=$new_image
        check_room $light
    else
        pin_images "$target"
        api_here
        old_image=$API_IMAGE new_image=$(answer EIGEN_API_IMAGE "$PINS")
        # Apart: an assignment stops on its last substitution only.
        old=$(describe "$old_image")
        new=$(describe "$new_image")
        # What .env.production pins before the switch is what the rollback snapshot pins.
        KEEP=$(for name in $IMAGES; do image "$name"; done)
    fi

    API_IMAGE=$new_image
    step "Adding what is new to .env.production" ".env.production has what Eigen $new needs" \
        "Could not update .env.production" cli configure --backfill

    # From the stop on, a hangup must not end the update halfway (dash runs no EXIT trap on one), and whatever ends it
    # starts Eigen again.
    trap '' HUP
    AT_EXIT=restart
    stop
    # The running version makes the snapshot, so it records that version for a rollback.
    kind=full
    if [ -n "$light" ]; then kind=light; fi
    API_IMAGE=$old_image
    step "Saving a $kind snapshot" "Snapshot saved" "Could not save the snapshot" cli_as 0 snapshot --pre-update $light
    API_IMAGE=$new_image
    if [ "$MODE" = source ]; then
        step "Switching to Eigen $new" "Switched to Eigen $new" "Could not switch to Eigen $new" switch_images
    else
        step "Switching to Eigen $new" "Switched to Eigen $new" "Could not write Eigen $new into .env.production" \
            with_pins cli configure --backfill
    fi
    AT_EXIT=''
    restart "Fix what it says, then run ./eigen restart, or ./eigen rollback to go back to Eigen $old."
    step "Removing old images" "Old images removed" "Could not remove the old images" prune_images
    say "$GREEN" '◇' "Eigen ${old:+$old → }$new is running at https://$domain/"
    say "$GRAY" '│' "Saved before the update: snapshots/$(answer archive "$(cat .eigen/last-update)"), a $kind snapshot"
    if [ "$MODE" = source ]; then
        leftovers=''
        for dir in dist node_modules; do
            if [ -e "$dir" ]; then leftovers="$leftovers $dir/"; fi
        done
        if [ -n "$leftovers" ]; then
            say "$GRAY" '│' "Eigen builds in Docker; unless you develop here, delete:$leftovers"
        fi
    fi
    say "$GRAY" '└' "./eigen rollback goes back to Eigen $old."
}

# The pre-update snapshot brings back the data and .env.production, checked while Eigen runs. A release install then
# gets the images it pins and their bundle files; a source install checks out the old commit and builds it.
rollback() {
    yes=''
    for arg in "$@"; do
        case $arg in
            -h | --help)
                command_usage rollback
                exit 0
                ;;
            --yes) yes=--yes ;;
            *) refuse rollback "$arg" ;;
        esac
    done
    need_install
    wordmark rollback
    if [ ! -f .eigen/last-update ]; then
        die "There is no update to roll back." "./eigen rollback goes back after an ./eigen update."
    fi
    # LAST_UPDATE in apps/api/src/cli/snapshot.ts: the CLI writes these keys.
    last=$(cat .eigen/last-update)
    archive=$(answer archive "$last") commit=$(answer commit "$last") kind=$(answer kind "$last")
    back="$(answer version "$last") ($commit)"
    if [ ! -f "snapshots/$archive" ]; then
        die "snapshots/$archive, saved before the update, is gone." "Restore another snapshot with ./eigen restore <snapshot>."
    fi
    preflight
    lock
    if [ "$MODE" = source ]; then
        need_git_owner
        changed=$(git status --porcelain --untracked-files=no | cut -c4- | tr '\n' ' ')
        if [ -n "$changed" ]; then
            die "Local changes are in the way of the rollback: $changed" "Keep them with git stash, or drop them with git checkout -- <file>; then run ./eigen rollback again."
        fi
        current="$EIGEN_VERSION ($EIGEN_COMMIT)"
    else
        api_here
        current=$(describe "$(image api)")
    fi
    say "$ACCENT" '◆' "Back from Eigen $current to Eigen $back, from a $kind snapshot"
    check_snapshot "$archive" $yes
    if [ "$MODE" = source ]; then
        # git replaces this file rather than writing into it, so the running sh reads on in its own copy.
        step "Checking out $commit" "Checked out $commit" "Could not check out $commit" git reset --hard "$commit"
        source_env
        step "Building Eigen $back" "Eigen $back built" "Could not build Eigen $back; Eigen runs on as it was" build_next
    else
        pins=$(cli_as 0 restore "$archive" --checked </dev/null)
        pull_pinned "$pins"
        back=$(describe "$(answer EIGEN_API_IMAGE "$pins")")
    fi
    swap_snapshot "$archive"
    if [ "$MODE" = source ]; then
        step "Switching to Eigen $back" "Switched to Eigen $back" "Could not switch to Eigen $back" switch_images
    else
        write_bundle "$(answer EIGEN_API_IMAGE "$pins")"
    fi
    AT_EXIT=''
    restart
    rm -f .eigen/last-update
    say "$GREEN" '◇' "Eigen $current → $back is running at https://$(env_value DOMAIN)/"
    say "$GRAY" '└' "Check that all is well, then delete what was kept aside."
}

COMMAND=${1:-}
if [ $# -gt 0 ]; then shift; fi
# dash runs the EXIT trap on an exit, not on a signal.
trap 'exit 130' INT TERM
case $COMMAND in
    setup) setup "$@" ;;
    status) status "$@" ;;
    update) update "$@" ;;
    rollback) rollback "$@" ;;
    restart)
        arguments restart 0 "$@"
        need_install
        wordmark restart
        preflight
        lock
        restart
        ;;
    stop)
        arguments stop 0 "$@"
        need_install
        wordmark stop
        preflight
        lock
        stop
        ;;
    reset-password)
        case ${1:-} in -h | --help) cli_help reset-password ;; esac
        need_install
        wordmark reset-password
        if ! dc ps --status running --services 2>/dev/null | grep -qx eigen-api; then
            die "Eigen is not running." "Run ./eigen logs eigen-api to see why."
        fi
        api_cli reset-password "$@"
        ;;
    backup) backup "$@" ;;
    restore) restore "$@" ;;
    logs)
        arguments logs 1 "$@"
        need_install
        if [ $# = 1 ] && ! dc config --services | grep -qx -- "$1"; then
            die "Eigen has no service \"$1\"." "Pick one of: $(dc config --services | paste -s -d , - | sed 's/,/, /g')."
        fi
        dc logs -f --tail 200 "$@"
        ;;
    help | -h | --help) usage ;;
    *)
        if [ -n "$COMMAND" ]; then printf 'Unknown command "%s".\n\n' "$COMMAND" >&2; fi
        usage >&2
        exit 2
        ;;
esac
