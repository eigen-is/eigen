#!/bin/sh
# Eigen's launcher. Every Docker step runs here, because no container gets the Docker socket; everything
# that asks a question or writes config is the CLI in the API image. POSIX sh: runs under dash and BusyBox.
set -eu

# Through a symlink such as /usr/local/bin/eigen too, this runs in the install folder.
cd "$(dirname "$(readlink -f "$0")")"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    ACCENT=$(printf '\033[1;36m') GREEN=$(printf '\033[32m') RED=$(printf '\033[31m')
    YELLOW=$(printf '\033[33m') GRAY=$(printf '\033[90m') RESET=$(printf '\033[0m')
else
    ACCENT='' GREEN='' RED='' YELLOW='' GRAY='' RESET=''
fi
LOG=.eigen/last-step.log
# POSIX sleep only takes whole seconds; the spinner falls back to 1 where 0.2 fails.
TICK=0.2

usage() {
    cat <<EOF
Usage: ./eigen <command>

Commands:
  setup            Configure Eigen, start it and print the link that finishes the setup
  status           Report on Eigen, its services, disk space, snapshots and certificate
  update           Update Eigen to the newest version
  rollback         Go back to the version before the last update
  restart          Start Eigen, and any part of it that stopped
  reset-password   Set a new password for an account
  backup           Save Eigen as a snapshot in snapshots/
  restore          Put a snapshot back
  logs             Follow the logs
  help             Show this help

./eigen <command> --help tells more about one.

Environment:
  NO_COLOR=1           Plain output without color.
  EIGEN_ALLOW_ARCH=1   Run on a server that is not x86_64. Unsupported: Eigen's images are
                       built for x86_64 only.
EOF
}

# The usage of the commands the launcher runs alone; the CLI prints its own for the others.
command_usage() {
    case $1 in
        status) printf '%s\n' 'Usage: ./eigen status' '' \
            'Reports on the version, a pending update, the services, disk space, the last snapshot,' \
            'the certificate and the mail queue.' ;;
        backup) printf '%s\n' 'Usage: ./eigen backup' '' \
            'Stops Eigen, saves data/ and .env.production as a snapshot in snapshots/, and starts' \
            'Eigen again. Only the owner of this folder can read the snapshot.' ;;
        logs) printf '%s\n' 'Usage: ./eigen logs [service]' '' \
            'Follows the logs of every service, or of one: eigen-api, caddy, eigen-static, postfix,' \
            'dovecot, unbound.' ;;
        update) printf '%s\n' 'Usage: ./eigen update [version] [--check] [--accept-breaking]' '' \
            'Updates Eigen to the newest release, or to <version>, and saves a snapshot first that' \
            './eigen rollback goes back to. A source install pulls the newest commit and builds it.' '' \
            '  --check             Only tell whether there is an update, and what it brings' \
            '  --accept-breaking   Update even when the new version lists breaking changes' ;;
        rollback) printf '%s\n' 'Usage: ./eigen rollback [--yes]' '' \
            'Goes back to the version before the last ./eigen update, with the data as it was then.' \
            'The current data is kept aside.' '' \
            '  --yes   Do not ask' ;;
        restart) printf '%s\n' 'Usage: ./eigen restart' '' \
            'Starts Eigen, and any part of it that stopped.' ;;
    esac
}

# refuse <command> <argument>: an argument the command does not take, with its usage.
refuse() {
    printf 'Unknown argument "%s".\n\n' "$2" >&2
    command_usage "$1" >&2
    exit 2
}

# arguments <command> <how many it takes> <argument…>: --help prints its usage; one argument too many is refused
# with it.
arguments() {
    command=$1 takes=$2
    shift 2
    for arg in "$@"; do
        case $arg in -h | --help)
            command_usage "$command"
            exit 0
            ;;
        esac
    done
    if [ $# -gt "$takes" ]; then
        shift "$takes"
        refuse "$command" "$1"
    fi
}

say() { printf '%s%s%s  %s\n' "$1" "$2" "$RESET" "$3"; }

# die <what went wrong> <what to do next>
die() {
    say "$RED" '■' "$1" >&2
    say "$GRAY" '└' "$2" >&2
    exit 1
}

# The last KEY= line of .env.production in configure's own format: 'quoted', "quoted", or bare up to a ` #`.
env_value() {
    if [ ! -f .env.production ]; then return 0; fi
    value=$(sed -n "s/^$1=//p" .env.production | tail -n 1)
    case $value in
        \'*) value=${value#?}; printf '%s\n' "${value%%\'*}" ;;
        \"*) value=${value#?}; printf '%s\n' "${value%%\"*}" ;;
        *) printf '%s\n' "$value" | sed 's/[[:space:]]\{1,\}#.*//; s/[[:space:]]*$//' ;;
    esac
}

# Configure always writes DOMAIN; a file without it is left from a setup that did not finish. An unreadable one is
# for preflight to report.
installed() { [ -e .env.production ] && { [ ! -r .env.production ] || [ -n "$(env_value DOMAIN)" ]; }; }

# version_at_least <have> <want>, both like 2.24.4
version_at_least() {
    awk -v have="$1" -v want="$2" 'BEGIN {
        split(have, h, /[^0-9]+/); split(want, w, /[^0-9]+/)
        for (i = 1; i <= 3; i++) if (h[i] + 0 != w[i] + 0) exit !(h[i] + 0 > w[i] + 0)
        exit 0
    }'
}

if [ -e .git ] && [ -f docker-compose.build.yml ]; then MODE=source; else MODE=release; fi

# Compose's project name: COMPOSE_PROJECT_NAME as given (Compose refuses an invalid one), else the folder name
# normalized the way Compose does it.
EIGEN_PROJECT=${COMPOSE_PROJECT_NAME:-$(env_value COMPOSE_PROJECT_NAME)}
if [ -z "$EIGEN_PROJECT" ]; then
    EIGEN_PROJECT=$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-' | sed 's/^[_-]*//')
fi
export EIGEN_PROJECT

API_IMAGE=${EIGEN_API_IMAGE:-$(env_value EIGEN_API_IMAGE)}
API_IMAGE=${API_IMAGE:-ghcr.io/eigen-is/eigen/api:local}

# Compose interpolates the build overlay for every command, so a source install always exports these.
if [ "$MODE" = source ]; then
    BUN_VERSION=$(cat .bun-version)
    EIGEN_VERSION=$(sed -n 's/^  "version": "\(.*\)",$/\1/p' package.json | head -n 1)
    EIGEN_COMMIT=$(git -c safe.directory="$PWD" rev-parse --short HEAD 2>/dev/null || true)
    EIGEN_BUILT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    export BUN_VERSION EIGEN_VERSION EIGEN_COMMIT EIGEN_BUILT_AT
fi

dc() {
    if [ -f docker-compose.override.yml ]; then set -- -f docker-compose.override.yml "$@"; fi
    if [ "$MODE" = source ]; then set -- -f docker-compose.build.yml "$@"; fi
    docker compose --env-file .env.production -f docker-compose.yml "$@"
}

# The CLI inside the running API container, the only way to its control socket. exec bypasses the image
# entrypoint, so the entry is spelled out; Compose's exec wants a terminal unless told -T. A terminal on stdin
# alone gets one too, or a password typed there would echo.
API_CLI=/app/apps/api/src/cli/index.ts
EXEC_TTY=-T
if [ -t 0 ]; then EXEC_TTY=''; fi

# cli_as <uid:gid> <command…>: the CLI in the API image on this folder, with the variables CLI_ENV names.
CLI_ENV=''
cli_as() {
    user=$1
    shift
    tty=''
    if [ -t 0 ]; then tty=-t; fi
    env=''
    for name in $CLI_ENV; do env="$env -e $name"; done
    docker run --rm --init -i $tty -e TERM -e NO_COLOR $env --user "$user" -e HOME=/tmp \
        -v "$PWD:/install" -w /install "$API_IMAGE" "$@"
}

# The CLI as the operator, so what it writes is theirs.
cli() { cli_as "$(id -u):$(id -g)" "$@"; }

# step <while running> <when done> <on failure> <command…>: one line per step, the output in $LOG. On a terminal
# the command runs as a background job under a spinner with the elapsed time and the log's last line; set -m gives
# the job its own process group, so Ctrl-C can stop all of it. Every caller traps INT with exit 130 or leaves it
# fatal, so exit 130 is the trap a step leaves behind.
step() {
    running=$1 done=$2 failed=$3
    shift 3
    code=0
    if [ -t 1 ]; then
        set -m
        (set +e; "$@") >"$LOG" 2>&1 </dev/null &
        job=$!
        set +m
        trap 'kill -s TERM -- "-$job" 2>/dev/null || :; wait "$job" 2>/dev/null || :; printf "\r\033[K\033[1A\r\033[K\033[?25h"
            say "$RED" "■" "$running: cancelled." >&2; exit 130' INT TERM
        started=$(date +%s)
        frame=0
        printf '\033[?25l\n'
        while kill -0 "$job" 2>/dev/null; do
            case $((frame % 4)) in 0) glyph=◒ ;; 1) glyph=◐ ;; 2) glyph=◓ ;; *) glyph=◑ ;; esac
            frame=$((frame + 1))
            seconds=$(($(date +%s) - started))
            elapsed=${seconds}s
            if [ "$seconds" -ge 60 ]; then elapsed="$((seconds / 60))m $((seconds % 60))s"; fi
            width=$(stty size </dev/tty 2>/dev/null || :)
            width=${width#* }
            case $width in '' | 0 | *[!0-9]*) width=80 ;; esac
            # A wrapped line would break the redraw. BuildKit's "#12 3.45 …" loses its step number and timestamp.
            line=$(tail -n 20 "$LOG" 2>/dev/null | awk -v width=$((width - 4)) '{
                sub(/.*\r/, ""); gsub(/\033\[[0-9;?]*[A-Za-z]/, ""); gsub(/[[:cntrl:]]/, " ")
                sub(/^#[0-9]+ ([0-9]+\.[0-9]+ )?/, "")
            } NF && !/^(DONE [0-9.]+s|CACHED)$/ { line = $0 } END { print substr(line, 1, width) }')
            printf '\r\033[K\033[1A\r\033[K%s%s%s  %s...  %s%s%s\n\033[K%s│  %s%s' "$ACCENT" "$glyph" "$RESET" \
                "$running" "$GRAY" "$elapsed" "$RESET" "$GRAY" "$line" "$RESET"
            sleep "$TICK" 2>/dev/null || TICK=1
        done
        wait "$job" 2>/dev/null || code=$?
        trap 'exit 130' INT TERM
        printf '\r\033[K\033[1A\r\033[K\033[?25h'
    else
        "$@" >"$LOG" 2>&1 </dev/null || code=$?
    fi
    if [ "$code" = 0 ]; then
        say "$GREEN" '◇' "$done"
        return 0
    fi
    {
        say "$RED" '■' "$failed"
        tail -n 20 "$LOG" | sed "s/^/${GRAY}│${RESET}  /"
        say "$GRAY" '└' "Full output: $LOG.${AGAIN- Fix what it says, then run ./eigen $COMMAND again.}"
    } >&2
    exit 1
}

wordmark() { printf '\n%seigen|%s>%s\n\n' "$ACCENT" "$1" "$RESET"; }

# The CLI comes with the API image, which a source install builds in ./eigen setup.
need_image() {
    if [ "$MODE" = source ] && ! docker image inspect "$API_IMAGE" >/dev/null 2>&1; then
        die "Eigen is not built yet." "$1"
    fi
}

preflight() {
    if [ -e .env.production ] && [ ! -r .env.production ]; then
        die ".env.production is not readable by this user." "Run ./eigen as the user that owns it, or as root."
    fi
    server=$(docker info --format '{{.ServerVersion}} {{.Architecture}}' 2>/dev/null || true)
    if [ -z "${server%% *}" ]; then
        die "Docker is not running, or this user cannot use it." "Start Docker, or run ./eigen as root or a member of the docker group."
    fi
    compose=$(docker compose version --short 2>/dev/null || true)
    compose=${compose#v}
    if [ -z "$compose" ]; then
        die "Docker Compose is not installed." "Install the Docker Compose plugin, version 2.20 or newer."
    fi
    need=2.20
    if [ -f docker-compose.override.yml ] && grep -q '!override' docker-compose.override.yml; then need=2.24.4; fi
    if ! version_at_least "$compose" "$need"; then
        die "Docker Compose $compose is too old for this install; it needs $need or newer." "Update the Docker Compose plugin, then run ./eigen $COMMAND again."
    fi
    arch=${server#* }
    case $arch in
        x86_64 | amd64) ;;
        *)
            if [ "${EIGEN_ALLOW_ARCH:-}" != 1 ]; then
                die "Eigen runs on x86_64 servers; this Docker runs on $arch." "Use an x86_64 server."
            fi
            say "$YELLOW" '▲' "$arch is unsupported; going on because EIGEN_ALLOW_ARCH=1."
            ;;
    esac
    say "$GREEN" '◇' "Docker ${server%% *}, Compose $compose"
}

# docker pull <registry>/<name>:<version> for each image
pull_images() {
    for name in api frontend postfix dovecot; do
        docker pull "$1/$name:$2" || return 1
    done
}

# pin_images <registry> <version>: the registry digest of each pulled image, in PIN_API … PIN_DOVECOT.
pin_images() {
    for name in api frontend postfix dovecot; do
        digest=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' \
            "$1/$name:$2" | grep -F "$1/$name@" | head -n 1)
        if [ -z "$digest" ]; then
            die "$1/$name:$2 has no registry digest." "Remove the local image (docker image rm $1/$name:$2) and run ./eigen $COMMAND again."
        fi
        case $name in
            api) PIN_API=$digest ;;
            frontend) PIN_FRONTEND=$digest ;;
            postfix) PIN_POSTFIX=$digest ;;
            dovecot) PIN_DOVECOT=$digest ;;
        esac
    done
}

# export_pins <registry> <version>: the release pins configure writes; Compose reads them from here too, over the
# file.
export_pins() {
    EIGEN_REGISTRY=$1 EIGEN_VERSION=$2 EIGEN_API_IMAGE=$PIN_API EIGEN_FRONTEND_IMAGE=$PIN_FRONTEND
    EIGEN_POSTFIX_IMAGE=$PIN_POSTFIX EIGEN_DOVECOT_IMAGE=$PIN_DOVECOT
    export EIGEN_REGISTRY EIGEN_VERSION EIGEN_API_IMAGE EIGEN_FRONTEND_IMAGE EIGEN_POSTFIX_IMAGE EIGEN_DOVECOT_IMAGE
    CLI_ENV="$CLI_ENV EIGEN_REGISTRY EIGEN_VERSION EIGEN_API_IMAGE EIGEN_FRONTEND_IMAGE EIGEN_POSTFIX_IMAGE"
    CLI_ENV="$CLI_ENV EIGEN_DOVECOT_IMAGE"
    API_IMAGE=$PIN_API
}

# Removes this project's containers whose service the current profiles no longer include, so a rerun that
# switches web or mail mode converges instead of leaving the old mode running. Runs under step (set -e off), so
# failures return explicitly: a broken config must not read as "no services".
start() {
    services=$(dc config --services) || return 1
    active=" $(printf '%s ' $services)"
    stale=$(docker ps -a --filter "label=com.docker.compose.project=$EIGEN_PROJECT" \
        --format '{{.ID}} {{.Label "com.docker.compose.service"}}' | while read -r id service; do
        case $active in (*" $service "*) ;; (*) echo "$id" ;; esac
    done)
    if [ -n "$stale" ]; then docker rm -f $stale || return 1; fi
    dc up -d --wait
}

# The server runs as 1000:1000. Only an empty folder is handed over: an existing one keeps its owners.
prepare_data() {
    mkdir -p data backups || return 1
    for dir in data backups; do
        if [ -z "$(ls -A "$dir" 2>/dev/null || echo unreadable)" ]; then
            docker run --rm --user 0 --entrypoint chown -v "$PWD/$dir:/$dir" "$API_IMAGE" 1000:1000 "/$dir" || return 1
        fi
    done
    docker run --rm --user 1000:1000 --entrypoint sh -v "$PWD/data:/data" -v "$PWD/backups:/backups" "$API_IMAGE" \
        -c 'for dir in /data /backups; do touch "$dir/.eigen-write-test" && rm "$dir/.eigen-write-test" || exit 1; done' || {
        echo "Eigen runs as uid 1000 and cannot write here. Give it the folders: sudo chown 1000:1000 data backups"
        return 1
    }
}

setup() {
    case ${1:-} in
        -h | --help)
            need_image "Run ./eigen setup; ./eigen setup --help works after that."
            cli configure --help
            return
            ;;
    esac
    relay=''
    previous=''
    for arg in "$@"; do
        case $previous in --relay-password-env) relay=$arg ;; esac
        case $arg in --relay-password-env=*) relay=${arg#*=} ;; esac
        previous=$arg
    done
    case $relay in [0-9]* | *[!A-Za-z0-9_]*)
        die "--relay-password-env takes a variable name, like RELAY_PASSWORD." "Export the password in a variable and pass its name."
        ;;
    esac
    CLI_ENV="EIGEN_PROJECT EIGEN_DOCKER_NETWORKS $relay"

    wordmark setup
    preflight
    mkdir -p .eigen

    if [ "$MODE" = source ]; then
        # Compose loads env_file: even to build, so a first run needs the file before configure writes it. Left
        # empty by a setup that ends before that, it would read as an install.
        if [ ! -e .env.production ]; then (umask 077 && : >.env.production); fi
        trap '[ -s .env.production ] || rm -f .env.production' EXIT
        trap 'exit 130' INT TERM
        step "Building Eigen" "Eigen built" "Could not build Eigen" dc build eigen-api
    else
        registry=${EIGEN_REGISTRY:-$(env_value EIGEN_REGISTRY)}
        version=${EIGEN_VERSION:-$(env_value EIGEN_VERSION)}
        if [ -z "$registry" ] || [ -z "$version" ]; then
            die ".env.production names no Eigen release." "Get one first: docker run --rm -v \"\$PWD:/out\" ghcr.io/eigen-is/eigen/api bootstrap"
        fi
        step "Downloading Eigen $version" "Eigen $version downloaded" "Could not download Eigen $version" \
            pull_images "$registry" "$version"
        pin_images "$registry" "$version"
        export_pins "$registry" "$version"
    fi

    # configure picks a free subnet from this list; the CLI container cannot ask Docker itself.
    docker network inspect $(docker network ls -q) >.eigen/networks.json ||
        die "Could not list the Docker networks." "Check that Docker is running, then run ./eigen setup again."
    EIGEN_DOCKER_NETWORKS=/install/.eigen/networks.json
    export EIGEN_DOCKER_NETWORKS
    cli configure "$@" || exit
    trap - EXIT

    if [ "$MODE" = source ]; then
        step "Building the web and mail images" "Images built" "Could not build the images" dc build
    fi
    step "Preparing data/ and backups/" "Data folders ready" "The data folders are not writable" prepare_data
    step "Starting Eigen" "Eigen is running" "Eigen did not start; ./eigen logs shows why" start

    # The one-time link to finish in the browser, or where to sign in when setup is already done.
    dc exec $EXEC_TTY -e NO_COLOR="${NO_COLOR:-}" eigen-api bun "$API_CLI" setup-link
}

# Once the snapshot or the restore is done, running that command again would repeat it: a failed start points at
# ./eigen restart instead.
restart() {
    AGAIN=' Fix what it says, then run ./eigen restart.'
    step "Starting Eigen" "Eigen is running" "Eigen did not start; ./eigen logs shows why" start
}

# The snapshot is taken with every service stopped (dovecot and postfix write to data/ too), as root in a container
# so the mixed owners in data/ survive. snapshots/ is the operator's alone, and no service of Eigen mounts it. Eigen
# starts again whatever happens to the snapshot.
backup() {
    arguments backup 0 "$@"
    if ! installed; then die "Eigen is not set up in $PWD." "Run ./eigen setup first."; fi
    wordmark backup
    preflight
    mkdir -p .eigen
    (umask 077 && mkdir -p snapshots)
    trap restart EXIT
    trap 'exit 130' INT TERM
    step "Stopping Eigen" "Eigen stopped" "Could not stop Eigen" dc stop
    cli_as 0 snapshot
}

# Two CLI runs as root. While Eigen still runs, restore --check asks (a no is its exit 3), unpacks and checks the
# snapshot into .eigen/restore and names it in .eigen/restore/.snapshot; once Eigen is stopped, restore without
# --check swaps that marked copy in. So a refusal stops nothing, and the downtime is the swap alone. Eigen starts
# again whatever happens to the swap. An interrupt reaches the CLI, which says how it ended, so the launcher waits
# for it instead of leaving.
restore() {
    case ${1:-} in -h | --help)
        need_image "Run ./eigen setup first; ./eigen restore --help works after that."
        cli restore --help
        return
        ;;
    esac
    wordmark restore
    preflight
    need_image "Run ./eigen setup first, then ./eigen restore <snapshot>."
    mkdir -p .eigen
    trap : INT TERM
    checked=0
    cli_as 0 restore "$@" --check || checked=$?
    case $checked in 0) ;; 3) exit 0 ;; *) exit "$checked" ;; esac
    # A stop that fails or is interrupted leaves root's checked copy, a whole data/, for root to remove.
    trap 'cli_as 0 rm -rf .eigen/restore; restart' EXIT
    trap 'exit 130' INT TERM
    if [ -f .env.production ]; then step "Stopping Eigen" "Eigen stopped" "Could not stop Eigen" dc stop; fi
    trap : INT TERM
    # Not $code: restart's step sets that.
    restored=0
    cli_as 0 restore "$@" --yes || restored=$?
    trap - EXIT INT TERM
    restart
    case $restored in
        0) say "$GRAY" '└' "Check that all is well, then delete what was kept aside." ;;
        130)
            say "$GRAY" '└' "The restore was cancelled. Eigen runs on the data it had."
            exit 130
            ;;
        *) exit "$restored" ;;
    esac
}

# Only the launcher can ask Docker and read snapshots/, so it gathers the services, a pending update, the mail queue
# and the newest snapshot for the report. With Eigen down there is no socket to reach, and the CLI runs on its own.
status() {
    arguments status 0 "$@"
    if ! installed; then die "Eigen is not set up in $PWD." "Run ./eigen setup first."; fi
    wordmark status
    preflight >/dev/null
    tab=$(printf '\t')
    listed=$(dc ps -a --format "{{.Service}}$tab{{.State}}$tab{{.Health}}") ||
        die "Could not read the state of the services." "Fix what Docker Compose says above, then run ./eigen status again."
    services=''
    for service in $(dc config --services); do
        line=$(printf '%s\n' "$listed" | grep "^$service$tab" | head -n 1)
        services="$services${line:-$service${tab}missing$tab}
"
    done

    # Silent and best effort: a check that fails reads as unknown, one that cannot run leaves the row out. A fetch
    # as another user than the checkout's owner would leave objects in .git that the owner cannot write.
    update=''
    if [ "$MODE" = source ]; then
        if [ -O .git ] && git rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1; then
            update=unknown
            if GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes' git fetch --quiet >/dev/null 2>&1 &&
                behind=$(git rev-list --count 'HEAD..@{upstream}' 2>/dev/null); then
                if [ "$behind" = 0 ]; then update=current; else update="available $behind"; fi
            fi
        fi
    else
        case $API_IMAGE in *@sha256:*)
            update=unknown
            registry=${EIGEN_REGISTRY:-$(env_value EIGEN_REGISTRY)}
            latest=$(docker manifest inspect -v "$registry/api:latest" 2>/dev/null |
                sed -n 's/^ *"digest": *"\(sha256:[0-9a-f]*\)".*/\1/p' | head -n 1)
            if [ "${API_IMAGE#*@}" = "$latest" ]; then update=current; elif [ -n "$latest" ]; then update=available; fi
            ;;
        esac
    fi

    # Empty when postqueue fails; the CLI tells that from a stopped postfix by the service list.
    queue=''
    case $services in *"postfix${tab}running$tab"*)
        if queue=$(dc exec -T postfix postqueue -p 2>/dev/null); then
            queue=$(printf '%s\n' "$queue" | tail -n 1)
        else
            queue=''
        fi
        ;;
    esac

    # Sorted by the time in the name, or every pre-update snapshot would sort after the manual ones.
    snapshot=$(ls snapshots 2>/dev/null |
        sed -n 's/^eigen-\(pre-update-\)\{0,1\}\([0-9]\{8\}-[0-9]\{6\}\)\.tar\.gz$/\2 &/p' | sort | tail -n 1)

    EIGEN_STATUS_SERVICES=$services EIGEN_STATUS_UPDATE=$update EIGEN_STATUS_MAIL_QUEUE=$queue
    EIGEN_STATUS_SNAPSHOT=${snapshot#* }
    export EIGEN_STATUS_SERVICES EIGEN_STATUS_UPDATE EIGEN_STATUS_MAIL_QUEUE EIGEN_STATUS_SNAPSHOT
    case $services in
        *"eigen-api${tab}running$tab"*)
            dc exec $EXEC_TTY -e NO_COLOR="${NO_COLOR:-}" -e EIGEN_STATUS_SERVICES="$services" \
                -e EIGEN_STATUS_UPDATE="$update" -e EIGEN_STATUS_MAIL_QUEUE="$queue" \
                -e EIGEN_STATUS_SNAPSHOT="$EIGEN_STATUS_SNAPSHOT" eigen-api bun "$API_CLI" status
            ;;
        *)
            CLI_ENV='EIGEN_STATUS_SERVICES EIGEN_STATUS_UPDATE EIGEN_STATUS_MAIL_QUEUE EIGEN_STATUS_SNAPSHOT'
            cli status
            ;;
    esac
}

SOURCE_LABEL=org.opencontainers.image.source=https://github.com/eigen-is/eigen

# The images an update left behind. Release: every version tag of this registry's four images but the new version and
# the one a rollback returns to. Both: dangling images of Eigen, which a source install narrows to its own project,
# and a source install's build cache older than a week. Best effort: a failure here breaks nothing.
prune_images() {
    if [ "$MODE" = release ]; then
        for name in api frontend postfix dovecot; do
            for tag in $(docker image ls "$1/$name" --format '{{.Tag}}'); do
                case $tag in
                    "$2" | "$3") ;;
                    latest | [0-9]*.[0-9]*.[0-9]*) docker image rm "$1/$name:$tag" || : ;;
                esac
            done
        done
        docker image prune -f --filter "label=$SOURCE_LABEL" || :
    else
        docker image prune -f --filter "label=$SOURCE_LABEL" --filter "label=com.docker.compose.project=$EIGEN_PROJECT" || :
        docker builder prune -f --filter until=168h || :
    fi
}

# Fail2ban's jails follow the mail containers' logs by container ID, so recreated containers need a reload; the
# filters come with Eigen, the jail is the operator's.
refresh_fail2ban() {
    jail=/etc/fail2ban/jail.d/eigen-mail-sasl.conf
    if [ ! -e "$jail" ]; then return 0; fi
    filters="$PWD/docker/fail2ban/filter.d"
    if [ -w "$jail" ] && command -v fail2ban-client >/dev/null && cp "$filters"/*.conf /etc/fail2ban/filter.d/ &&
        fail2ban-client reload >/dev/null 2>&1; then
        say "$GREEN" '◇' "Fail2ban filters refreshed and jails reloaded"
    else
        say "$YELLOW" '▲' "Fail2ban still watches the old mail containers. As root, run:"
        say "$GRAY" '│' "cp $filters/*.conf /etc/fail2ban/filter.d/ && fail2ban-client reload"
    fi
}

# The newest version running is the goal, and every rerun converges on it. The launcher the operator typed gets the new
# version while Eigen runs, then hands over (--pulled) to the launcher that came with it, which stops, saves a snapshot
# and switches: a version brings its own update steps. Nothing stops before all of the new version is here.
update() {
    target='' check=0 accept='' pulled=0
    for arg in "$@"; do
        case $arg in
            -h | --help)
                command_usage update
                exit 0
                ;;
            --check) check=1 ;;
            --accept-breaking) accept=--accept-breaking ;;
            --pulled) pulled=1 ;;
            -*) refuse update "$arg" ;;
            *) if [ -n "$target" ]; then refuse update "$arg"; fi; target=$arg ;;
        esac
    done
    if ! installed; then die "Eigen is not set up in $PWD." "Run ./eigen setup first."; fi
    if [ "$pulled" = 0 ]; then
        wordmark update
        preflight
    fi
    mkdir -p .eigen
    domain=$(env_value DOMAIN)

    if [ "$MODE" = source ]; then
        if [ -n "$target" ] && [ "$pulled" = 0 ]; then
            die "A source install updates to the newest commit; it takes no version." "Run ./eigen update."
        fi
        # Git run by another user would leave objects in .git that its owner cannot write.
        if [ ! -O .git ]; then die "This checkout belongs to another user." "Run ./eigen update as the owner of $PWD/.git."; fi
        if [ "$pulled" = 0 ]; then
            upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) ||
                die "This checkout follows no branch." "Set one with git branch --set-upstream-to origin/main, then run ./eigen update again."
            if [ "$check" = 1 ]; then
                git fetch --quiet >"$LOG" 2>&1 ||
                    die "Could not fetch $upstream: $(tail -n 1 "$LOG")" "Check the network, then run ./eigen update --check again."
                behind=$(git rev-list --count 'HEAD..@{upstream}')
                if [ "$behind" = 0 ]; then
                    say "$GREEN" '◇' "Eigen is up to date with $upstream."
                else
                    say "$YELLOW" '▲' "$behind new commit$([ "$behind" = 1 ] || echo s) on $upstream:"
                    git log --format='%h %s' 'HEAD..@{upstream}' | head -n 10 | sed "s/^/${GRAY}│${RESET}  /"
                    say "$GRAY" '└' "./eigen update installs them."
                fi
                exit 0
            fi
            before=$(git rev-parse HEAD)
            if ! git pull --ff-only >"$LOG" 2>&1; then
                if grep -q 'would be overwritten' "$LOG"; then
                    files=$(sed -n "s/^$(printf '\t')//p" "$LOG" | tr '\n' ' ')
                    die "Local changes are in the way of the update: $files" "Keep them with git stash, or drop them with git checkout -- <file>; then run ./eigen update again."
                elif grep -qi 'fast-forward' "$LOG"; then
                    die "This checkout has commits that $upstream does not have." "Put them on top with git rebase $upstream, or drop them with git reset --hard $upstream; then run ./eigen update again."
                fi
                die "Could not pull $upstream: $(tail -n 1 "$LOG")" "Fix what it says, then run ./eigen update again. Full output: $LOG."
            fi
            count=$(git rev-list --count "$before..HEAD")
            if [ "$count" = 0 ]; then
                say "$GREEN" '◇' "No new commits on $upstream"
            else
                say "$GREEN" '◇' "Pulled $count new commit$([ "$count" = 1 ] || echo s) from $upstream"
            fi
            # The pulled launcher runs the rest; --pulled is the contract between any two versions of it.
            exec ./eigen update --pulled
        fi

        # The running API's commit, which the pre-update snapshot is made with; none when Eigen never started.
        container=$(dc ps -a -q eigen-api 2>/dev/null | head -n 1)
        old_image='' old='' old_commit=''
        if [ -n "$container" ]; then
            old_image=$(docker inspect --format '{{.Image}}' "$container")
            old=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$old_image")
            old_commit=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$old_image")
        fi
        new="$EIGEN_VERSION ($EIGEN_COMMIT)"
        if [ -n "$old_commit" ] && [ "$old_commit" = "$EIGEN_COMMIT" ]; then
            step "Starting Eigen" "Eigen is running" "Eigen did not start; ./eigen logs shows why" start
            say "$GRAY" '└' "Eigen $new is up to date and running at https://$domain/"
            exit 0
        fi
        step "Building Eigen $new" "Eigen $new built" "Could not build Eigen $new; Eigen runs on as it was" dc build
        old=${old:+$old ($old_commit)}
        old_image=${old_image:-$API_IMAGE}
        new_image=$API_IMAGE
    else
        registry=$(env_value EIGEN_REGISTRY)
        old=$(env_value EIGEN_VERSION)
        if [ -z "$registry" ] || [ -z "$old" ]; then
            die ".env.production names no Eigen release." "Run ./eigen setup first."
        fi
        if [ "$pulled" = 0 ]; then
            # latest, or the version asked for, is pulled only to learn its version.
            if [ -n "$target" ]; then AGAIN=' Releases: https://github.com/eigen-is/eigen/releases'; fi
            step "Looking for Eigen ${target:-updates}" "Found Eigen ${target:-updates}" "Could not get Eigen ${target:-updates}" \
                docker pull "$registry/api:${target:-latest}"
            unset AGAIN
            new=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' \
                "$registry/api:${target:-latest}")
            if [ -z "$new" ]; then
                die "$registry/api:${target:-latest} names no version." "Name one: ./eigen update <version>. Releases: https://github.com/eigen-is/eigen/releases"
            fi
            if [ "$new" = "$old" ]; then
                if [ "$check" = 1 ]; then
                    say "$GRAY" '└' "Eigen $old is up to date."
                    exit 0
                fi
                step "Starting Eigen" "Eigen is running" "Eigen did not start; ./eigen logs shows why" start
                say "$GRAY" '└' "Eigen $old is up to date and running at https://$domain/"
                exit 0
            fi
            if ! version_at_least "$new" "$old"; then
                die "Eigen $new is older than Eigen $old, which runs here." "./eigen rollback goes back to the version before the last update."
            fi
            API_IMAGE=$registry/api:${target:-latest}
            if [ "$check" = 1 ]; then
                cli update-check --from "$old" --accept-breaking
                say "$GRAY" '└' "Eigen $new is out. ./eigen update installs it."
                exit 0
            fi
            step "Downloading Eigen $new" "Eigen $new downloaded" "Could not download Eigen $new" \
                pull_images "$registry" "$new"
            API_IMAGE=$registry/api:$new
            checked=0
            cli update-check --from "$old" $accept || checked=$?
            case $checked in 0) ;; 3) exit 0 ;; *) exit "$checked" ;; esac
            # Written to temporary files and renamed, so this running launcher keeps reading its own copy.
            step "Writing the Eigen $new launcher and Compose files" "Eigen $new files written" \
                "Could not write the Eigen $new files" cli bootstrap --force --out /install
            exec ./eigen update --pulled "$new"
        fi
        new=$target
        pin_images "$registry" "$new"
        old_image=$API_IMAGE
        new_image=$PIN_API
    fi

    API_IMAGE=$new_image
    step "Adding what is new to .env.production" ".env.production has what Eigen $new needs" \
        "Could not update .env.production" cli configure --backfill

    # The snapshot below holds a copy of data/, so the disk needs room for it before anything stops.
    (umask 077 && mkdir -p snapshots)
    used=$(docker run --rm --user 0 --entrypoint du -v "$PWD/data:/data:ro" "$old_image" -sk /data) ||
        die "Could not measure data/." "Fix what it says, then run ./eigen update again."
    used=${used%%[!0-9]*}
    free=$(df -Pk snapshots | awk 'NR == 2 { print $4 }')
    if [ "$used" -gt "$free" ]; then
        die "The snapshot before the update needs up to $((used / 1024)) MB; snapshots/ has $((free / 1024)) MB free." "Free space on that disk, or delete old snapshots from snapshots/; then run ./eigen update again."
    fi

    # From the stop on, a hangup must not end the update halfway (dash runs no EXIT trap on one), and whatever ends it
    # starts Eigen again.
    trap '' HUP
    trap restart EXIT
    trap 'exit 130' INT TERM
    step "Stopping Eigen" "Eigen stopped" "Could not stop Eigen" dc stop
    # The running version makes it, so it records that version and a rollback can restore it.
    API_IMAGE=$old_image
    step "Saving a snapshot" "Snapshot saved" "Could not save the snapshot" cli_as 0 snapshot --pre-update
    archive=$(sed -n 's/.*Saved snapshots\/\(eigen-pre-update-[0-9]\{8\}-[0-9]\{6\}\.tar\.gz\).*/\1/p' "$LOG")
    printf '%s\n%s\n' "$archive" "${old%% *}" >.eigen/last-update
    if [ "$MODE" = release ]; then
        export_pins "$registry" "$new"
        step "Switching to Eigen $new" "Switched to Eigen $new" "Could not write Eigen $new into .env.production" \
            cli configure --backfill
        AGAIN=" ./eigen rollback goes back to Eigen $old."
    else
        AGAIN=' ./eigen rollback says how to go back.'
    fi
    trap - EXIT
    step "Starting Eigen $new" "Eigen $new is running" "Eigen $new did not start; ./eigen logs shows why" start
    unset AGAIN

    refresh_fail2ban
    step "Removing old images" "Old images removed" "Could not remove the old images" \
        prune_images "${registry:-}" "$new" "$old"
    say "$GREEN" '◇' "Eigen ${old:+$old → }$new is running at https://$domain/"
    say "$GRAY" '│' "Saved before the update: snapshots/$archive"
    if [ "$MODE" = source ]; then
        leftovers=''
        for dir in dist node_modules; do
            if [ -e "$dir" ]; then leftovers="$leftovers $dir/"; fi
        done
        if [ -n "$leftovers" ]; then
            say "$GRAY" '│' "Eigen builds in Docker now; unless you develop here, delete:$leftovers"
        fi
    fi
    say "$GRAY" '└' "./eigen rollback goes back to how it was."
}

# Release installs only: the pre-update snapshot brings back the data and the old pins, and the old image writes its
# own launcher and Compose files. The restore runs like ./eigen restore: checked while Eigen runs, then swapped.
rollback() {
    yes=''
    for arg in "$@"; do
        case $arg in
            -h | --help)
                command_usage rollback
                exit 0
                ;;
            --yes) yes=--yes ;;
            *) refuse rollback "$arg" ;;
        esac
    done
    if ! installed; then die "Eigen is not set up in $PWD." "Run ./eigen setup first."; fi
    wordmark rollback
    if [ ! -f .eigen/last-update ]; then
        die "There is no update to roll back." "./eigen rollback goes back after an ./eigen update."
    fi
    archive=$(sed -n 1p .eigen/last-update)
    back=$(sed -n 2p .eigen/last-update)
    if [ "$MODE" = source ]; then
        say "$GRAY" '│' "A source install runs the code of this checkout; git takes it back."
        say "$GRAY" '└' "The data as it was before the update: ./eigen restore $archive"
        exit 0
    fi
    if [ ! -f "snapshots/$archive" ]; then
        die "snapshots/$archive, saved before the update, is gone." "Restore another snapshot with ./eigen restore <snapshot>."
    fi
    preflight
    current=$(env_value EIGEN_VERSION)
    say "$ACCENT" '◆' "Back from Eigen $current to Eigen $back"
    mkdir -p .eigen
    trap : INT TERM
    checked=0
    cli_as 0 restore "$archive" --check $yes || checked=$?
    case $checked in 0) ;; 3) exit 0 ;; *) exit "$checked" ;; esac
    trap 'cli_as 0 rm -rf .eigen/restore; restart' EXIT
    trap 'exit 130' INT TERM
    step "Stopping Eigen" "Eigen stopped" "Could not stop Eigen" dc stop
    trap : INT TERM
    restored=0
    cli_as 0 restore "$archive" --yes || restored=$?
    if [ "$restored" != 0 ]; then
        trap - EXIT INT TERM
        restart
        exit "$restored"
    fi
    trap restart EXIT
    trap 'exit 130' INT TERM
    # The restored .env.production pins the old images; a prune may have removed them.
    API_IMAGE=$(env_value EIGEN_API_IMAGE)
    step "Getting Eigen $back" "Eigen $back is here" "Could not get Eigen $back" pull_pinned
    step "Writing the Eigen $back launcher and Compose files" "Eigen $back files written" \
        "Could not write the Eigen $back files" cli bootstrap --force --out /install
    trap - EXIT
    step "Starting Eigen $back" "Eigen $back is running" "Eigen $back did not start; ./eigen logs shows why" start
    rm -f .eigen/last-update
    say "$GREEN" '◇' "Eigen $current → $back is running at https://$(env_value DOMAIN)/"
    say "$GRAY" '└' "Check that all is well, then delete what was kept aside."
}

# The images .env.production pins, those missing pulled by their digest.
pull_pinned() {
    for key in EIGEN_API_IMAGE EIGEN_FRONTEND_IMAGE EIGEN_POSTFIX_IMAGE EIGEN_DOVECOT_IMAGE; do
        image=$(env_value "$key")
        docker image inspect "$image" >/dev/null 2>&1 || docker pull "$image" || return 1
    done
}

COMMAND=${1:-}
if [ $# -gt 0 ]; then shift; fi
case $COMMAND in
    setup) setup "$@" ;;
    status) status "$@" ;;
    reset-password)
        case ${1:-} in -h | --help)
            cli reset-password --help
            exit
            ;;
        esac
        if ! installed; then die "Eigen is not set up in $PWD." "Run ./eigen setup first."; fi
        wordmark reset-password
        if ! dc ps --status running --services 2>/dev/null | grep -qx eigen-api; then
            die "Eigen is not running." "Run ./eigen logs eigen-api to see why."
        fi
        dc exec $EXEC_TTY -e NO_COLOR="${NO_COLOR:-}" eigen-api bun "$API_CLI" reset-password "$@"
        ;;
    update) update "$@" ;;
    rollback) rollback "$@" ;;
    restart)
        arguments restart 0 "$@"
        if ! installed; then die "Eigen is not set up in $PWD." "Run ./eigen setup first."; fi
        wordmark restart
        preflight
        mkdir -p .eigen
        step "Starting Eigen" "Eigen is running" "Eigen did not start; ./eigen logs shows why" start
        ;;
    backup) backup "$@" ;;
    restore) restore "$@" ;;
    logs)
        arguments logs 1 "$@"
        if ! installed; then die "Eigen is not set up in $PWD." "Run ./eigen setup first."; fi
        if [ $# = 1 ] && ! dc config --services | grep -qx -- "$1"; then
            die "Eigen has no service \"$1\"." "Pick one of: $(dc config --services | paste -s -d , - | sed 's/,/, /g')."
        fi
        dc logs -f --tail 200 "$@"
        ;;
    help | -h | --help) usage ;;
    *)
        if [ -n "$COMMAND" ]; then printf 'Unknown command "%s".\n\n' "$COMMAND" >&2; fi
        usage >&2
        exit 2
        ;;
esac
