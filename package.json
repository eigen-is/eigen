{
  "name": "eigen",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "release": "bun scripts/release.ts",
    "serve": "bun --filter '*' dev",
    "serve:index": "bun --filter '@apps/api' --filter './apps/index' dev",
    "serve:mail": "bun --filter '@apps/api' --filter './apps/mail' dev",
    "serve:space": "bun --filter '@apps/api' --filter './apps/space' dev",
    "serve:calendar": "bun --filter '@apps/api' --filter './apps/calendar' dev",
    "serve:contacts": "bun --filter '@apps/api' --filter './apps/contacts' dev",
    "serve:drive": "bun --filter '@apps/api' --filter './apps/drive' dev",
    "serve:docs": "bun --filter '@apps/api' --filter './apps/docs' dev",
    "serve:stickies": "bun --filter '@apps/api' --filter './apps/stickies' dev",
    "serve:chat": "bun --filter '@apps/api' --filter './apps/chat' dev",
    "serve:admin": "bun --filter '@apps/api' --filter './apps/admin' dev",
    "serve:slides": "bun --filter '@apps/api' --filter './apps/slides' dev",
    "serve:sheets": "bun --filter '@apps/api' --filter './apps/sheets' dev",
    "serve:vector": "bun --filter '@apps/api' --filter './apps/vector' dev",
    "setup": "bun scripts/setup.ts",
    "build": "bun --workspaces build",
    "build:prod": "bun --filter './apps/*' build && bun --filter '@apps/api' buildfordocker",
    "lint": "bunx --bun @biomejs/biome check .",
    "lint:fix": "bunx --bun @biomejs/biome check --write .",
    "typecheck": "bun run --sequential --workspaces typecheck",
    "test": "bun --filter '*' test",
    "test:api": "bun --filter '@apps/api' test",
    "test:sheet": "bun --filter '@workspace/sheet' test",
    "primitives": "bun scripts/generate-shared-primitives.ts",
    "primitives:check": "bun scripts/generate-shared-primitives.ts --check",
    "standards": "bun scripts/check-standards.ts",
    "standards:update": "bun scripts/check-standards.ts --update",
    "check": "bun run lint && bun run typecheck && bun scripts/check-home-imports.ts && bun scripts/check-test-layout.ts && bun scripts/check-docs-links.ts && bun run standards && bun run primitives:check && bun run test"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@elysiajs/server-timing": "^1.4.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/he": "^1.2.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "resolutions": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "trustedDependencies": []
}
