{
  "name": "eigen",
  "private": true,
  "scripts": {
    "serve": "bun --filter '*' dev",
    "serve:admin": "bun --filter '@apps/api' --filter './apps/admin' dev",
    "serve:index": "bun --filter '@apps/api' --filter './apps/index' dev",
    "serve:mail": "bun --filter '@apps/api' --filter './apps/mail' dev",
    "serve:space": "bun --filter '@apps/api' --filter './apps/space' dev",
    "serve:calendar": "bun --filter '@apps/api' --filter './apps/calendar' dev",
    "serve:contacts": "bun --filter '@apps/api' --filter './apps/contacts' dev",
    "serve:drive": "bun --filter '@apps/api' --filter './apps/drive' dev",
    "serve:docs": "bun --filter '@apps/api' --filter './apps/docs' dev",
    "serve:stickies": "bun --filter '@apps/api' --filter './apps/stickies' dev",
    "serve:setup": "bun --filter '@apps/api' --filter './apps/setup' dev",
    "build": "bun --filter '*' build",
    "build:prod": "bun --filter './apps/*' build && bun --filter '@apps/api' buildfordocker",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '@apps/api' test",
    "check": "bun run typecheck && bun run test"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tanstack/react-router": "^1.140.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-query": "^5.75.0",
    "@tanstack/react-query-devtools": "^5.75.0",
    "lucide-react": "^0.480.0",
    "zod": "^3.24.2",
    "react-hook-form": "^7.56.0",
    "@hookform/resolvers": "^4.1.3",
    "date-fns": "^4.1.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "sonner": "^2.0.7",
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^20",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@tanstack/router-plugin": "^1.140.0",
    "@tanstack/react-router-devtools": "latest",
    "tailwindcss": "^4.1.17",
    "postcss": "^8.5.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "trustedDependencies": []
}