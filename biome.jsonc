{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.gen.ts",
      // Machine-generated by jison — regenerate upstream rather than edit.
      "!packages/sheet/src/engine/parser/grammar-parser/grammar-parser.ts",
      "!!dist",
      "!!coverage",
      "!!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off",
        // The package exports maps are the module resolver; extension-suffixed workspace
        // specifiers don't resolve through them. See CODE-STANDARDS.md § Imports.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@workspace/**/*.ts", "@workspace/**/*.tsx"],
                "message": "Workspace imports resolve through the package exports map — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
              },
              {
                "group": ["./**/*.ts", "./**/*.tsx", "../**/*.ts", "../**/*.tsx"],
                "message": "Relative imports resolve extensionless under moduleResolution: bundler — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
              }
            ]
          }
        }
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        // Recommended only warns; the tree is at zero and `any` breaks the Eden Treaty type chain.
        "noExplicitAny": "error"
      },
      "a11y": {
        "recommended": false
      }
    }
  },
  // Architectural seams that tsc can't catch: a React import pulled into the
  // backend-shared layers explodes at module-eval, not at typecheck. See AGENTS.md.
  "overrides": [
    {
      // The sheet engine is imported by apps/api — it MUST stay React-free.
      "includes": ["packages/sheet/src/engine/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": { "message": "engine/ is imported by the backend and must stay React-free." },
                  "react-dom": { "message": "engine/ is imported by the backend and must stay React-free." }
                },
                // Overrides replace the root rule options wholesale — restate the suffix ban.
                "patterns": [
                  {
                    "group": ["@workspace/**/*.ts", "@workspace/**/*.tsx"],
                    "message": "Workspace imports resolve through the package exports map — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  },
                  {
                    "group": ["./**/*.ts", "./**/*.tsx", "../**/*.ts", "../**/*.tsx"],
                    "message": "Relative imports resolve extensionless under moduleResolution: bundler — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Dependency direction is one-way: sheet/ui -> lib, never the reverse (would pull React into the backend).
      "includes": ["packages/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@workspace/sheet", "@workspace/sheet/**", "@workspace/ui", "@workspace/ui/**"],
                    "message": "lib must not import sheet or ui (would pull React into the backend). Put shared sheet types in packages/lib/src/sheets/types.ts."
                  },
                  // Overrides replace the root rule options wholesale — restate the suffix ban.
                  {
                    "group": ["@workspace/**/*.ts", "@workspace/**/*.tsx"],
                    "message": "Workspace imports resolve through the package exports map — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  },
                  {
                    "group": ["./**/*.ts", "./**/*.tsx", "../**/*.ts", "../**/*.tsx"],
                    "message": "Relative imports resolve extensionless under moduleResolution: bundler — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  }
}
