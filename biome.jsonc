{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.gen.ts",
      // Machine-generated by jison — regenerate upstream rather than edit.
      "!packages/sheet/src/engine/parser/grammar-parser/grammar-parser.ts",
      "!!dist",
      "!!coverage",
      "!!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off",
        "useImportType": { "level": "error", "options": { "style": "separatedType" } },
        "useConsistentMemberAccessibility": { "level": "error", "options": { "accessibility": "explicit" } },
        // The package exports maps are the module resolver; extension-suffixed workspace
        // specifiers don't resolve through them. See CODE-STANDARDS.md § Imports.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@workspace/**/*.ts", "@workspace/**/*.tsx"],
                "message": "Workspace imports resolve through the package exports map — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
              },
              {
                "group": ["./**/*.ts", "./**/*.tsx", "../**/*.ts", "../**/*.tsx"],
                "message": "Relative imports resolve extensionless under moduleResolution: bundler — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
              }
            ]
          }
        }
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        // Recommended only warns; the tree is at zero and `any` breaks the Eden Treaty type chain.
        "noExplicitAny": "error"
      },
      "a11y": {
        "preset": "none"
      }
    }
  },
  // Architectural seams that tsc can't catch: a React import pulled into the
  // backend-shared layers explodes at module-eval, not at typecheck. See AGENTS.md.
  "overrides": [
    {
      // The sheet's contenteditable editors read innerText on purpose: it keeps the line breaks the editor draws, textContent drops them.
      "includes": ["packages/sheet/src/**"],
      "linter": { "rules": { "performance": { "useDomNodeTextContent": "off" } } }
    },
    {
      // Vite loads these with Node's native TS loader, which needs full specifiers.
      "includes": ["**/vite.config.ts", "vite.shared.config.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      // The sheet engine is imported by apps/api — it MUST stay React-free.
      "includes": ["packages/sheet/src/engine/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": { "message": "engine/ is imported by the backend and must stay React-free." },
                  "react-dom": { "message": "engine/ is imported by the backend and must stay React-free." }
                },
                // Overrides replace the root rule options wholesale — restate the suffix ban.
                "patterns": [
                  {
                    "group": ["@workspace/**/*.ts", "@workspace/**/*.tsx"],
                    "message": "Workspace imports resolve through the package exports map — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  },
                  {
                    "group": ["./**/*.ts", "./**/*.tsx", "../**/*.ts", "../**/*.tsx"],
                    "message": "Relative imports resolve extensionless under moduleResolution: bundler — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Dependency direction is one-way: sheet/ui -> lib, never the reverse (would pull React into the backend).
      "includes": ["packages/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@workspace/sheet", "@workspace/sheet/**", "@workspace/ui", "@workspace/ui/**"],
                    "message": "lib must not import sheet or ui (would pull React into the backend). Put shared sheet types in packages/lib/src/sheets/types.ts."
                  },
                  {
                    "group": ["@workspace/formula", "@workspace/formula/text", "@workspace/formula/names"],
                    "message": "lib imports only the number-display entry of the engine: @workspace/formula/format."
                  },
                  // Overrides replace the root rule options wholesale — restate the suffix ban.
                  {
                    "group": ["@workspace/**/*.ts", "@workspace/**/*.tsx"],
                    "message": "Workspace imports resolve through the package exports map — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  },
                  {
                    "group": ["./**/*.ts", "./**/*.tsx", "../**/*.ts", "../**/*.tsx"],
                    "message": "Relative imports resolve extensionless under moduleResolution: bundler — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // math is a leaf below lib that the browser, Bun, Workers and Node run unchanged: it imports no package; its tsconfig holds no runtime API.
      "includes": ["packages/math/**", "!packages/math/src/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./**", "!../**"],
                    "message": "@workspace/math is a leaf: no dependencies (see ARCHITECTURE.md § Dependency direction)."
                  },
                  // Overrides replace the root rule options wholesale — restate the suffix ban.
                  {
                    "group": ["@workspace/**/*.ts", "@workspace/**/*.tsx"],
                    "message": "Workspace imports resolve through the package exports map — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  },
                  {
                    "group": ["./**/*.ts", "./**/*.tsx", "../**/*.ts", "../**/*.tsx"],
                    "message": "Relative imports resolve extensionless under moduleResolution: bundler — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // formula is the second leaf: the engine runs unchanged in the browser, Bun and Node, and imports no package.
      "includes": [
        "packages/formula/**",
        "!packages/formula/src/test/**",
        "!packages/formula/src/format/**",
        "!packages/formula/scripts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./**", "!../**"],
                    "message": "@workspace/formula is a leaf: it imports no package, and numfmt only in src/format (see ARCHITECTURE.md § Dependency direction)."
                  },
                  // Overrides replace the root rule options wholesale — restate the suffix ban.
                  {
                    "group": ["@workspace/**/*.ts", "@workspace/**/*.tsx"],
                    "message": "Workspace imports resolve through the package exports map — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  },
                  {
                    "group": ["./**/*.ts", "./**/*.tsx", "../**/*.ts", "../**/*.tsx"],
                    "message": "Relative imports resolve extensionless under moduleResolution: bundler — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // A function's body only computes: the call wrapper reads its arguments, so a family file imports no evaluator, store, recalc or coercion. The registry is the one file that makes the vocabulary from them. The reader of a text as a number, values/parse-number, is open: reading a text is what VALUE does.
      "includes": ["packages/formula/src/functions/**", "!packages/formula/src/functions/registry.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../eval/**", "../store/**", "../recalc/**", "../values/coerce"],
                    "message": "A function body does not coerce, evaluate or read a cell: declare a parameter from ./registry instead (see packages/formula/src/functions/registry.ts)."
                  },
                  // Overrides replace the root rule options wholesale — restate the leaf rule and the suffix ban.
                  {
                    "group": ["**", "!./**", "!../**"],
                    "message": "@workspace/formula is a leaf: it imports no package, and numfmt only in src/format (see ARCHITECTURE.md § Dependency direction)."
                  },
                  {
                    "group": ["@workspace/**/*.ts", "@workspace/**/*.tsx"],
                    "message": "Workspace imports resolve through the package exports map — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  },
                  {
                    "group": ["./**/*.ts", "./**/*.tsx", "../**/*.ts", "../**/*.tsx"],
                    "message": "Relative imports resolve extensionless under moduleResolution: bundler — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The engine computes the same on every machine: no clock and no locale but what a pass hands it.
      "includes": ["packages/formula/src/**", "!packages/formula/src/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "The engine reads no clock: take the time through the NOW parameter.",
                  "Intl": "The engine's text order and number display are its own, the same on every machine.",
                  "performance": "The engine reads no clock."
                }
              }
            }
          }
        }
      }
    },
    {
      // Its format module is the one place that imports numfmt, the package's one dependency.
      "includes": ["packages/formula/src/format/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./**", "!../**", "!numfmt"],
                    "message": "@workspace/formula is a leaf: numfmt is its only dependency (see ARCHITECTURE.md § Dependency direction)."
                  },
                  // Overrides replace the root rule options wholesale — restate the suffix ban.
                  {
                    "group": ["@workspace/**/*.ts", "@workspace/**/*.tsx"],
                    "message": "Workspace imports resolve through the package exports map — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  },
                  {
                    "group": ["./**/*.ts", "./**/*.tsx", "../**/*.ts", "../**/*.tsx"],
                    "message": "Relative imports resolve extensionless under moduleResolution: bundler — drop the .ts/.tsx suffix (see CODE-STANDARDS.md § Imports)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "markdown": {
    "parser": {
      // Help-center articles and blog posts open with YAML front matter.
      "frontmatter": true
    },
    "formatter": {
      // Off: it pads wide tables to one width and re-nests lists and blockquotes, which changes what they render.
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "indentWidth": 2
    }
  }
}
