#!/bin/sh
# Installs Eigen into the current folder, where its data will live: downloads the eigen command and runs ./eigen setup,
# or ./eigen restore, which sets Eigen up from a whole-server backup.
#   curl -fsSL https://eigen.is/install | sh
#   curl -fsSL https://eigen.is/install | sh -s -- --domain eigen.example.com --yes
#   curl -fsSL https://eigen.is/install | sh -s -- restore /root/server-scheduled-full-20261001-020000.tar
set -eu

command=setup
if [ "${1:-}" = restore ]; then
    command=restore
    shift
fi

if [ -e docker-compose.yml ] || [ -e .env.production ]; then
    # ./eigen restore needs no setup first: a folder whose .env.production has no DOMAIN restores as a new machine.
    if [ "$command" = restore ]; then
        echo "This folder already has an Eigen install. Run ./eigen restore <archive> in it." >&2
    else
        echo "This folder already has an Eigen install. Run ./eigen setup to change it, or ./eigen update." >&2
    fi
    exit 1
fi
case $PWD in "${HOME:-}" | /)
    echo "Eigen and its data get a folder of their own, not $PWD. Make one: mkdir -p /opt/eigen && cd /opt/eigen" >&2
    exit 1
    ;;
esac
# The launcher checks the rest: Compose and access to Docker.
if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is not installed. Install it first: https://docs.docker.com/engine/install/" >&2
    exit 1
fi

echo "Installing Eigen into $PWD. Its data will live in this folder."
launcher=https://raw.githubusercontent.com/eigen-is/eigen/main/eigen
if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o eigen.tmp "$launcher"
elif command -v wget >/dev/null 2>&1; then
    wget -q -O eigen.tmp "$launcher"
else
    echo "Neither curl nor wget is installed. Install one of them first." >&2
    exit 1
fi
if ! head -n 1 eigen.tmp | grep -q '^#!/bin/sh$'; then
    echo "The download is not the eigen command; try again later." >&2
    rm -f eigen.tmp
    exit 1
fi
chmod 755 eigen.tmp
mv eigen.tmp eigen

# Under curl | sh, stdin is the script; the questions need the terminal.
if [ -c /dev/tty ] && (exec </dev/tty) 2>/dev/null; then exec ./eigen "$command" "$@" </dev/tty; fi
exec ./eigen "$command" "$@"
