{
  "extends": "@workspace/config/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": "./src/",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@workspace/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@workspace/lib/*": [
        "../../packages/lib/src/lib/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}
