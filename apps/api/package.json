    "@types/nodemailer": "^6.4.23",
    "@types/uuid": "^11.0.0",
    "better-auth": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.28",
    "encoding-japanese": "^2.2.0",
