# Eigen deployment configuration.
# The easy way:  ./eigen setup (or bun run setup in a checkout) asks the setup questions and writes .env.production.
#                Rerunning it keeps your answers and every key it does not know.
# Manual:        copy this file to .env.production and edit the values.

# === REQUIRED ===
DOMAIN=eigen.example.com
# Address suffix for mailboxes (alice@MAIL_DOMAIN). Defaults to DOMAIN. Set to your apex
# (e.g. example.com) when web runs on a subdomain but mail uses the apex.
MAIL_DOMAIN=eigen.example.com
ACME_EMAIL=admin@example.com

# === DEPLOYMENT SHAPE ===
# Pick which optional services run:
#   edge,mail   = bundled Caddy + bundled mail (default, all-in-one)
#   static,mail = bundled frontend container + bundled mail (use with your own webserver)
#   edge        = bundled Caddy only, no mail hosted here (set MAIL_ENABLED=0)
#   static      = bundled frontend only, no mail hosted here (set MAIL_ENABLED=0)
COMPOSE_PROFILES=edge,mail
# 1 when Eigen hosts mail (the 'mail' profile), 0 when it does not: the apps then drop the Mail app,
# its palette entries, the "Mail to..." actions and the IMAP settings card.
MAIL_ENABLED=1
# Where the bundled static container is bound on the host. Your host webserver proxies
# to ${EIGEN_STATIC_HOST}:${EIGEN_STATIC_PORT}. Only used with the 'static' profile.
#   127.0.0.1 = localhost-only (recommended when proxy is on the same host)
#   0.0.0.0   = exposed on all interfaces (LAN-reachable)
EIGEN_STATIC_HOST=127.0.0.1
EIGEN_STATIC_PORT=8080

# === DOCKER NETWORK (only set if 172.20.0.0/24 conflicts with another network on your host) ===
# Both must stay consistent — the unbound IP must lie inside the subnet.
# EIGEN_SUBNET=172.30.0.0/24
# EIGEN_UNBOUND_IP=172.30.0.254

# === SYSTEM SENDER ===
# The From of notifications, codes and invitations: an address or "Name <address>". Unset, it is
# "<organization name> <noreply@MAIL_DOMAIN>".
# SMTP_FROM='Eigen <noreply@example.com>'

# === SMTP RELAY FOR THE BUNDLED MAIL (optional; needed when your VPS blocks outbound port 25) ===
# Postfix hands outgoing mail to this relay. Brevo free tier: 300 emails/day. Sign up at https://brevo.com
# SMTP_RELAY_HOST=smtp-relay.brevo.com
# SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=
# SMTP_RELAY_PASSWORD=

# === SMTP RELAY WITHOUT THE BUNDLED MAIL (only when COMPOSE_PROFILES omits 'mail') ===
# Without postfix the API sends through this server itself. Without one, Eigen sends no email: no
# two-factor codes by email, guest sign-in codes, share and access-request notifications, "Email
# collaborators", waitlist invitations, calendar invitations or RSVP replies.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# Set both or neither: a user without a password is a config error and the API refuses to build the
# transport. As soon as SMTP_USER is set, encryption becomes mandatory and the relay's certificate is verified.
# SMTP_USER=
# SMTP_PASSWORD=
# TLS mode. Defaults to implicit TLS on port 465 and STARTTLS everywhere else; 1/0 overrides it.
# SMTP_SECURE=1

# === ADVANCED (auto-derived from DOMAIN — only edit if you know what you're doing) ===
# PRODUCTION=1
# API_URL=https://eigen.example.com
# Frontend URLs are RELATIVE on purpose so the bundle works on any hostname (public
# domain, LAN IP, tunnel, ...). The runtime resolves them against window.location.origin.
# VITE_API_HOST=/eigen
# VITE_APP_ADMIN_URL=/admin     (and similarly /space, /mail, /drive, /docs, ...)
# TRUSTED_NETWORKS is not set here: docker-compose.yml derives it from EIGEN_SUBNET (loopback + the bridge subnet)
