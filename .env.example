# Eigen deployment configuration.
# The easy way:  bun run setup    (interactive — asks 4 questions, writes .env.production)
# Manual:        copy this file to .env.production and edit the values.

# === REQUIRED ===
DOMAIN=eigen.example.com
# Address suffix for mailboxes (alice@MAIL_DOMAIN). Defaults to DOMAIN. Set to your apex
# (e.g. example.com) when web runs on a subdomain but mail uses the apex.
MAIL_DOMAIN=eigen.example.com
ACME_EMAIL=admin@example.com

# === DEPLOYMENT SHAPE ===
# Pick which optional services run:
#   edge,mail   = bundled Caddy + bundled mail (default, all-in-one)
#   static,mail = bundled frontend container + bundled mail (use with your own webserver)
#   edge        = bundled Caddy only — your host runs its own mail server
#   static      = bundled frontend only — your host runs both webserver and mail
COMPOSE_PROFILES=edge,mail
# Where the bundled static container is bound on the host. Your host webserver proxies
# to ${EIGEN_STATIC_HOST}:${EIGEN_STATIC_PORT}. Only used with the 'static' profile.
#   127.0.0.1 = localhost-only (recommended when proxy is on the same host)
#   0.0.0.0   = exposed on all interfaces (LAN-reachable)
EIGEN_STATIC_HOST=127.0.0.1
EIGEN_STATIC_PORT=8080

# === DOCKER NETWORK (only set if 172.20.0.0/24 conflicts with another network on your host) ===
# Both must stay consistent — the unbound IP must lie inside the subnet.
# EIGEN_SUBNET=172.30.0.0/24
# EIGEN_UNBOUND_IP=172.30.0.254

# === SMTP RELAY (optional — required if VPS blocks outbound port 25) ===
# Brevo free tier: 300 emails/day. Sign up at https://brevo.com
# SMTP_RELAY_HOST=smtp-relay.brevo.com
# SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=
# SMTP_RELAY_PASSWORD=

# === HOST MAIL SERVER (only when COMPOSE_PROFILES omits 'mail') ===
# When the bundled postfix isn't running, point the API at your host's mail server. Default
# is `postfix` (the bundled container's name) — change when you opt out of the mail profile.
# SMTP_HOST=host.docker.internal
# SMTP_PORT=25

# === ADVANCED (auto-derived from DOMAIN — only edit if you know what you're doing) ===
# PRODUCTION=1
# Frontend URLs are RELATIVE on purpose so the bundle works on any hostname (public
# domain, LAN IP, tunnel, ...). The runtime resolves them against window.location.origin.
# VITE_API_HOST=/eigen
# VITE_APP_ADMIN_URL=/admin     (and similarly /space, /mail, /drive, /docs, ...)
# TRUSTED_NETWORKS=127.0.0.0/8,::1,172.16.0.0/12
